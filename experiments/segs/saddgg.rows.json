  {"n": "l2e", "at": "228c F", "to": "22ac", "pre": "l2", "post": "e2{u:=(yx+u)/268435456}", "stu": ["(yx + u) % 268435456"], "h": ["DGX", "SWC{j:=i}", "u ≤ 1", "i + 1 = mx", "mn ≤ i", "mx < 2 ^ 31"], "doc": "The second loop's last digit."},
  {"n": "l2f", "at": "22ac", "to": "22c4", "pre": "e2", "post": "tl", "h": ["mn < mx", "mx < 2 ^ 31"], "doc": "`tmpc := c->dp + max`."},
