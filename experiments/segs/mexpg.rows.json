  {"n": "l2n", "at": "edc F", "pre": "c2lr", "post": "c2l", "h": ["l2 ≠ 1", "l2 < 2 ^ 64"], "doc": "`mp_dr_is_modulus(P)`."},
  {"n": "dry", "at": "ee8 F", "to": "2c5c", "pre": "c2dr", "post": "tl{md:=1}", "h": ["RF", "dr = 1"], "doc": "`dr = 1`: tail call `s_mp_exptmod_fast(G, X, P, Y, 1)`."},
  {"n": "drn", "at": "ee8 T", "pre": "c2dr", "post": "c2l", "h": ["dr ≠ 1", "dr < 2 ^ 64"], "doc": "`mp_reduce_is_2k(P)`."},
  {"n": "k2y", "at": "f28 T", "to": "2c5c", "pre": "c2kr", "post": "tl{md:=2}", "h": ["RF", "k2 = 1"], "doc": "`dr = 2`: tail call `s_mp_exptmod_fast(G, X, P, Y, 2)`."},
  {"n": "kd", "at": "f28 F F", "to": "f3c", "pre": "c2kr", "post": "pd", "h": ["k2 ≠ 1", "k2 < 2 ^ 64", "PU", "pu ≠ 0", "PD"], "doc": "`P->used > 0`: `P->dp`."},
  {"n": "odd", "at": "f3c T", "to": "2c5c", "pre": "pd", "post": "tl{md:=0}", "h": ["RF", "D0", "d0 % 2 = 1"], "doc": "`P` odd: tail call `s_mp_exptmod_fast(G, X, P, Y, 0)`."},
