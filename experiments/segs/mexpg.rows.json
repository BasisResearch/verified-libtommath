  "PU": ["bytesT4 M pn = BitVec.ofNat 32 pu", "Ram pn 24", "pu < 2 ^ 31"],
  "PD": ["bytesT8 M (pn + 16) = BitVec.ofNat 64 ndp", "Ram pn 24"],
  "D0": ["bytesT4 M ndp = BitVec.ofNat 32 d0", "Ram ndp 4", "d0 < 2 ^ 31"]
 },
