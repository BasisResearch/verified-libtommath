  {"n": "ev", "at": "f3c F", "to": "261c", "pre": "pd", "post": "tl{md:=0}", "h": ["RF", "D0", "d0 % 2 = 0"], "doc": "`P` even: tail call `s_mp_exptmod(G, X, P, Y, 0)`."},
  {"n": "pxn", "at": "e94 F T", "pre": "ent", "post": "im", "h": ["PS", "ps ≠ 1", "XS", "xs = 1"], "doc": "Save `ra`, `s0`–`s4`; `X` negative: `mp_init_multi(&tmpG, &tmpX, NULL)`."},
  {"n": "ie", "at": "f8c F", "pre": "imr", "post": "rt", "h": ["RF", "e ≠ 0", "e < 2 ^ 64"], "doc": "`mp_init_multi` failed: return its error."},
