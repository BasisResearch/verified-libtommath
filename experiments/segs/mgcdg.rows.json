  {"n": "ms1", "at": "1260 F", "to": "126c", "pre": "e1{e:=0}", "post": "mz{e:=0}", "h": ["CS"], "doc": "`c->sign := MP_ZPOS`."},
  {"n": "ms2", "at": "126c", "pre": "mz", "post": "cu", "doc": "`err := MP_OKAY` in the frame; `mp_clear(&u)` (`LBL_V`)."},
  {"n": "c2", "at": "1168", "pre": "lh", "post": "cl3", "stu": ["e"], "h": ["ER"], "doc": "`mp_clear(&v)` (`LBL_U`)."},
  {"n": "c3", "at": "1178", "pre": "lh", "post": "rt", "h": ["RF", "ER"], "doc": "Restore, return `err`."}
 ]}
