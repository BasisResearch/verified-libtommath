 "facts": {
  "FF": ["rs: Ram (sp - 96) 96", "sp % 16 = 0", "96 ≤ sp", "sp ≤ mpGcdBase ∨ mpGcdBase + 532 ≤ sp - 96"],
  "UA": ["bytesT4 M pa = BitVec.ofNat 32 ua", "ua < 2 ^ 31", "Ram pa 24", "pa % 8 = 0"],
  "UB": ["bytesT4 M pb = BitVec.ofNat 32 ub", "ub < 2 ^ 31", "Ram pb 24", "pb % 8 = 0"],
  "RF": ["bytesT8 M (sp - 8) = ra", "bytesT8 M (sp - 16) = s0", "bytesT8 M (sp - 24) = s1"],
