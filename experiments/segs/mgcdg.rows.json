  {"n": "de", "at": "1138 F T", "to": "11c8", "pre": "dd", "post": "lh", "h": ["LB", "ul = vl"], "doc": "`u_lsb = v_lsb = k`: to the loop."},
  {"n": "du2", "at": "1248 T", "to": "11c8", "pre": "e1{e:=0}", "post": "lh", "doc": "To the loop."},
  {"n": "dv2", "at": "1154 T", "to": "11c8", "pre": "e1{e:=0}", "post": "lh", "doc": "To the loop."},
  {"n": "lz", "at": "11c8 T", "pre": "lh", "post": "mu", "h": ["VU", "vu = 0"], "doc": "`v = 0`: `mp_mul_2d(&u, k, c)`."},
  {"n": "lc", "at": "11c8 F", "pre": "lh", "post": "cm1", "h": ["VU", "vu ≠ 0"], "doc": "`v != 0`: `mp_cmp_mag(&u, &v)`."},
  {"n": "gt", "at": "11dc F", "pre": "cr1", "post": "cm1", "h": ["cm = 1"], "doc": "`MP_GT`: `mp_exch(&u, &v)`."},
  {"n": "le", "at": "11dc T", "pre": "cr1", "post": "sb", "h": ["cm ≠ 1", "cm < 2 ^ 64"], "doc": "Not `MP_GT`: `s_mp_sub(&v, &u, &v)`."},
  {"n": "xs", "at": "118c", "pre": "lh", "post": "sb", "doc": "After the exchange: `s_mp_sub(&v, &u, &v)`."},
  {"n": "sl", "at": "119c F", "pre": "e1{e:=0}", "post": "cl3", "doc": "`mp_cnt_lsb(&v)`."},
  {"n": "ld", "at": "11ac", "pre": "e1{e:=vl}", "post": "d5", "doc": "`mp_div_2d(&v, mp_cnt_lsb(&v), &v, NULL)`."},
