  {"n": "k3", "at": "1120 F T", "pre": "l2a", "post": "d1{k:=vl}", "h": ["LB", "vl < ul", "0 < vl"], "doc": "`k = v_lsb > 0`: save both counts; `mp_div_2d(&u, k, &u, NULL)`."},
  {"n": "k0a", "at": "1120 T F", "to": "1138", "pre": "l2a", "post": "dd{k:=ul}", "h": ["LB", "ul ≤ vl", "ul = 0"], "doc": "`k = u_lsb = 0`."},
  {"n": "k0b", "at": "1120 F F", "to": "1138", "pre": "l2a", "post": "dd{k:=vl}", "h": ["LB", "vl < ul", "vl = 0"], "doc": "`k = v_lsb = 0`."},
  {"n": "dk", "at": "1204 F", "pre": "e1{e:=0}", "post": "d2", "doc": "`mp_div_2d(&v, k, &v, NULL)`."},
