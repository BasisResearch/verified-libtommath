  "SU": ["bytesT8 M (sp - 96) = BitVec.ofNat 64 ul"],
  "SV": ["bytesT8 M (sp - 96) = BitVec.ofNat 64 ul", "bytesT8 M (sp - 88) = BitVec.ofNat 64 vl"],
  "VU": ["bytesT4 M (sp - 56) = BitVec.ofNat 32 vu", "vu < 2 ^ 31"],
  "LB": ["ul < 2 ^ 31", "vl < 2 ^ 31"],
  "CS": ["Ram pc 24", "pc % 8 = 0"]
 },
 "segs": [
  {"n": "za", "at": "105c T", "to": "05cc", "pre": "ent", "post": "ta", "h": ["UA", "ua = 0"], "doc": "`a = 0`: `return mp_abs(b, c)` (a tail call)."},
  {"n": "zb", "at": "105c F T", "to": "05cc", "pre": "ent", "post": "tb", "h": ["UA", "UB", "ua ≠ 0", "ub = 0"], "doc": "`b = 0`: `return mp_abs(a, c)` (a tail call)."},
  {"n": "p1", "at": "105c F F", "pre": "ent", "post": "ic1", "h": ["UA", "UB", "ua ≠ 0", "ub ≠ 0"], "doc": "Both nonzero: save `ra`, `s0`, `s1`; `mp_init_copy(&u, a)`."},
  {"n": "f1", "at": "1090 F", "pre": "r1", "post": "rt", "h": ["RF", "e ≠ 0", "e < 2 ^ 64"], "doc": "The first `mp_init_copy` failed: return its error."},
