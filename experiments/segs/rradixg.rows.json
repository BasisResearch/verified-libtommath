{
 "fn": "mp_read_radix", "mod": "ReadRadixG", "src": "rradixg", "pfx": "rrg", "imports": ["Tom.Machine.Fn.ReadRadixGK"],
 "bv": "ra s0 s1 s2 s3 s4 s5 s6 s7 s8 j7", "nat": "sp pa str rx d ng q c c2 u sz y e uu", "keep": "gp tp s9 s10 s11", "h0": ["FF"],
 "regs": {
  "ent": "ra sp s0 s1 s2 s3 s4 s5 s6 s7 s8 a0:pa a1:str a2:rx", "z1": "sp:sp-80 s0:pa s1:str s2:rx s3 s4 s5 s6 s7 s8 a0:pa", "k1": "@z1 -a0",
  "z2": "@k1 s1:str+d s8:ng a0:pa", "k2": "@z2 -a0", "hd": "sp:sp-80 s0:pa s1:q s2:rx s3:0x80017cc0 s4:36 s5:sz s6:25 s7:j7 s8:ng a4:c", "hs": "@hd -a4",
  "ch": "@hd a0:pa a1:rx a2:pa a5:u", "lk": "@ch -a5 a3:0x80017cc0+(u-40)", "md": "@hd s7:y a0:pa a1:rx a2:pa", "mr": "@hs s7:y a0:e",
  "ad": "@hs s7:y a0:pa a1:y a2:pa", "zz": "@hd a0:pa", "sr": "@hd a5:!0xffffffffffffdbfe#64", "sr1": "@hd a5:!(crlfMask c)",
  "fin": "sp:sp-80 s0:pa s8:ng", "rv": "ra sp s0 s1 s2 s3 s4 s5 s6 s7 s8 a0:!0xfffffffffffffffd#64", "rk": "@rv a0:0", "re": "@rv a0:e"
 },
 "facts": {
  "FF": ["rs: Ram (sp - 80) 80", "sp % 16 = 0", "80 ≤ sp", "sp ≤ mpReadRadixBase ∨ mpReadRadixBase + 456 ≤ sp - 80", "sp ≤ 0x80017cc0 ∨ 0x80018808 ≤ sp - 80"],
  "RF": ["bytesT8 M (sp - 8) = ra", "bytesT8 M (sp - 16) = s0", "bytesT8 M (sp - 24) = s1", "bytesT8 M (sp - 32) = s2"],
  "RS": ["bytesT8 M (sp - 40) = s3", "bytesT8 M (sp - 48) = s4", "bytesT8 M (sp - 56) = s5", "bytesT8 M (sp - 64) = s6", "bytesT8 M (sp - 72) = s7"],
  "R8": ["bytesT8 M (sp - 80) = s8"], "CF": ["bytesT1 M q = BitVec.ofNat 8 c", "c < 256", "Ram q 1"],
  "SF": ["Ram pa 24", "pa % 8 = 0", "pa + 24 ≤ mpReadRadixBase ∨ mpReadRadixBase + 456 ≤ pa", "pa + 24 ≤ sp - 80 ∨ sp ≤ pa"],
  "UF": ["bytesT4 M pa = BitVec.ofNat 32 uu", "uu < 2 ^ 31"], "TZ": ["bytesT8 M 0x80018800 = BitVec.ofNat 64 sz", "sz < 2 ^ 31"],
  "TY": ["bytesT1 M (0x80017cc0 + (u - 40)) = BitVec.ofNat 8 y", "y < 256", "40 ≤ u", "u < 256"]
 },
 "segs": [
  {"n": "pro", "at": "1b4c", "pre": "ent", "post": "z1", "doc": "Save `ra`, `s0`–`s2`; `mp_zero(a)`."},
  {"n": "bad", "at": "1b70 T", "pre": "k1", "post": "rv", "h": ["RF", "rx < 2 ∨ 64 < rx", "rx < 2 ^ 31"], "doc": "`radix` out of `[2, 64]`: `MP_VAL`."},
  {"n": "neg", "at": "1b70 F F", "pre": "k1", "post": "z2{d:=1, ng:=1}", "h": ["CF{q:=str}", "c = 45", "str + 1 ≤ sp - 80 ∨ sp ≤ str", "2 ≤ rx", "rx ≤ 64"], "doc": "A leading `-`."},
  {"n": "pos", "at": "1b70 F T", "pre": "k1", "post": "z2{d:=0, ng:=0}", "h": ["CF{q:=str}", "c ≠ 45", "str + 1 ≤ sp - 80 ∨ sp ≤ str", "2 ≤ rx", "rx ≤ 64"], "doc": "No leading `-`."},
  {"n": "emp1", "at": "1ba0 T T", "pre": "k2", "post": "rk", "h": ["RF", "R8", "SF", "UF", "CF{q:=str+d}", "c = 0", "uu ≠ 0", "ng < 2"], "doc": "The empty string, `a->used ≠ 0`: `a->sign := neg`, `MP_OKAY`."},
  {"n": "emp0", "at": "1ba0 T F", "pre": "k2", "post": "rk", "h": ["RF", "R8", "SF", "UF", "CF{q:=str+d}", "c = 0", "uu = 0"], "doc": "The empty string, `a->used = 0`: `MP_OKAY`."},
  {"n": "go", "at": "1ba0 F", "to": "1c18", "pre": "k2", "post": "hd{q:=str+d, j7:=s7}", "h": ["TZ", "CF{q:=str+d}", "c ≠ 0"], "doc": "A first character: save `s3`–`s7`, the table and its size; to the loop head."},
  {"n": "up0", "at": "1c18 T", "to": "1c40", "pre": "hd", "post": "ch{u:=c}", "h": ["36 < rx", "rx < 2 ^ 31"], "doc": "`radix > 36`: case-sensitive."},
  {"n": "up1", "at": "1c18 F T", "to": "1c40", "pre": "hd", "post": "ch{u:=c}", "h": ["rx ≤ 36", "c < 256", "c < 97 ∨ 122 < c"], "doc": "Not a lower-case letter."},
  {"n": "up2", "at": "1c18 F F", "to": "1c40", "pre": "hd", "post": "ch{u:=c-32}", "h": ["rx ≤ 36", "97 ≤ c", "c ≤ 122"], "doc": "A lower-case letter: `MP_TOUPPER`."},
  {"n": "inr", "at": "1c40 T", "to": "1bd8", "pre": "ch", "post": "lk", "h": ["40 ≤ u", "u - 40 ≤ sz", "u < 256", "sz < 2 ^ 31"], "doc": "`pos = ch - '('` within the table."},
  {"n": "oor", "at": "1c40 F", "to": "1c54", "pre": "ch", "post": "hd", "h": ["u < 40 ∨ sz < u - 40", "u < 256", "sz < 2 ^ 31"], "doc": "`pos` past the table: break."},
  {"n": "ff", "at": "1bd8 T", "to": "1c54", "pre": "lk", "post": "hd{j7:=BitVec.ofNat 64 y}", "h": ["TY", "y = 255"], "doc": "`y = 0xff`: break."},
  {"n": "ge", "at": "1bd8 F T", "to": "1c54", "pre": "lk", "post": "hd{j7:=BitVec.ofNat 64 y}", "h": ["TY", "y ≠ 255", "rx ≤ y", "rx < 2 ^ 31"], "doc": "`y ≥ radix`: break."},
  {"n": "dig", "at": "1bd8 F F", "pre": "lk", "post": "md", "h": ["TY", "y ≠ 255", "y < rx", "rx < 2 ^ 31"], "doc": "A digit `y`: `mp_mul_d(a, radix, a)`."},
  {"n": "mde", "at": "1bec T", "pre": "mr", "post": "re", "h": ["RF", "RS", "R8", "e ≠ 0", "e < 2 ^ 64"], "doc": "`mp_mul_d` failed: return its error."},
  {"n": "mdo", "at": "1bec F", "pre": "mr{e:=0}", "post": "ad", "doc": "`mp_add_d(a, y, a)`."},
  {"n": "ade", "at": "1c04 T", "pre": "mr", "post": "re", "h": ["RF", "RS", "R8", "e ≠ 0", "e < 2 ^ 64"], "doc": "`mp_add_d` failed: return its error."},
  {"n": "nxt", "at": "1c04 F F", "to": "1c18", "pre": "mr{e:=0}", "post": "hd{q:=q+1, c:=c2, j7:=BitVec.ofNat 64 y}", "h": ["CF{q:=q+1, c:=c2}", "c2 ≠ 0"], "doc": "The next character: back to the loop head."},
  {"n": "end", "at": "1c04 F T", "to": "1c98", "pre": "mr{e:=0}", "post": "fin", "h": ["CF{q:=q+1, c:=c2}", "c2 = 0"], "doc": "The end of the string."},
  {"n": "bz", "at": "1c54 F", "pre": "hd", "post": "zz", "h": ["13 < c", "c < 256"], "doc": "An illegal character: `mp_zero(a)`."},
  {"n": "bs", "at": "1c54 T", "pre": "hd", "post": "sr", "h": ["c ≤ 13"], "doc": "`c ≤ 13`: the mask `0x…dbfe` (to the `sra`)."},
  {"n": "sra", "at": "1c8c", "alu": "sra", "pre": "sr", "post": "sr1", "eqs": ["crlfMask"], "doc": "`sra a5, a5, a4` (one step)."},
  {"n": "bsz", "at": "1c90 T", "pre": "sr1", "post": "zz", "h": ["c < 14", "c ≠ 0", "c ≠ 10", "c ≠ 13"], "doc": "Not `\\0`, `\\r`, `\\n`: an illegal character, `mp_zero(a)`."},
  {"n": "bsf", "at": "1c90 F", "to": "1c98", "pre": "sr1", "post": "fin", "h": ["c < 14", "c = 0 ∨ c = 10 ∨ c = 13"], "doc": "`\\r` or `\\n`: done."},
  {"n": "zr", "at": "1c64", "pre": "hs", "post": "rv", "h": ["RF", "RS", "R8"], "doc": "After `mp_zero`: `MP_VAL`."},
  {"n": "fn1", "at": "1c98 T", "pre": "fin", "post": "rk", "h": ["RF", "RS", "R8", "SF", "UF", "uu ≠ 0", "ng < 2"], "doc": "Done, `a->used ≠ 0`: `a->sign := neg`, `MP_OKAY`."},
  {"n": "fn0", "at": "1c98 F", "pre": "fin", "post": "rk", "h": ["RF", "RS", "R8", "SF", "UF", "uu = 0"], "doc": "Done, `a->used = 0`: `MP_OKAY`."}
 ]}
