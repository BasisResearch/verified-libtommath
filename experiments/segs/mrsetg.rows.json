{
 "fn": "mp_reduce_setup",
 "mod": "MpReduceSetupG",
 "src": "mrsetg",
 "pfx": "mrs",
 "imports": [
  "Tom.Machine.Kit.GenX_seg5a",
  "Tom.Machine.Fn.MpReduceSetupGK"
 ],
 "bv": "ra s0 s1",
 "nat": "sp pa pb ub e",
 "keep": "gp tp s2 s3 s4 s5 s6 s7 s8 s9 s10 s11",
 "h0": [
  "FF"
 ],
 "regs": {
  "ent": "ra sp s0 s1 a0:pa a1:pb",
  "ce": "sp:sp-32 s0:pb s1:pa a0:pa a1:56*ub",
  "cr": "sp:sp-32 s0:pb s1:pa a0:0",
  "cre": "sp:sp-32 s0:pb s1:pa a0:e",
  "rte": "ra sp s0 s1 a0:e",
  "tb": "ra sp s0 s1 a0:pa a1:pb a2:pa a3:0",
  "p1": "ra sp:sp-32 s0:pb s1 a0:pa a1:pb a5:ub",
  "p2": "ra sp:sp-32 s0:pb s1 a0:pa a1:56*ub"
 },
 "facts": {
  "FF": [
   "rs: Ram (sp - 32) 32",
   "sp % 16 = 0",
   "32 ≤ sp",
   "sp ≤ mpReduceSetupBase ∨ mpReduceSetupBase + 104 ≤ sp - 32"
  ],
  "UB": [
   "bytesT4 M pb = BitVec.ofNat 32 ub",
   "Ram pb 24",
   "56 * ub < 2 ^ 31"
  ],
  "RF": [
   "bytesT8 M (sp - 8) = ra",
   "bytesT8 M (sp - 16) = s0",
   "bytesT8 M (sp - 24) = s1"
  ]
 },
 "segs": [
  {
   "n": "pro",
   "at": "63a8",
   "to": "63b8",
   "pre": "ent",
   "post": "p1",
   "h": [
    "UB"
   ],
   "doc": "`b->used`; the frame, save `s0`."
  },
  {
   "n": "pk",
   "at": "63b8",
   "to": "63c4",
   "pre": "p1",
   "post": "p2",
   "h": [
    "56 * ub < 2 ^ 31"
   ],
   "doc": "`b->used * 2 * MP_DIGIT_BIT` (`slliw`, `subw`, `slliw`: `56 b->used`)."
  },
  {
   "n": "pc",
   "at": "63c4",
   "pre": "p2",
   "post": "ce",
   "doc": "Save `s1`, `ra`; `mp_2expt(a, 56 b->used)`."
  },
  {
   "n": "tl",
   "at": "63d4 T",
   "to": "0898",
   "pre": "cr",
   "post": "tb",
   "h": [
    "RF"
   ],
   "doc": "Restore; tail to `mp_div(a, b, a, NULL)`."
  },
  {
   "n": "fe",
   "at": "63d4 F",
   "pre": "cre",
   "post": "rte",
   "h": [
    "RF",
    "e ≠ 0",
    "e < 2 ^ 64"
   ],
   "doc": "`mp_2expt` failed (it grows `a`): restore, return its error."
  }
 ]
}
