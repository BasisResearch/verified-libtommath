{
 "fn": "mp_invmod", "mod": "MpInvmodG", "src": "minvg", "pfx": "miv", "imports": ["Tom.Machine.Kit.Parity"],
 "bv": "ra s0 s1 s2", "nat": "sp pa pb pc bdp sb ub d0 cm e", "keep": "gp tp s3 s4 s5 s6 s7 s8 s9 s10 s11", "h0": ["FF"],
 "regs": {
  "ent": "ra sp s0 s1 s2 a0:pa a1:pb a2:pc",
  "cd": "sp:sp-48 s0:pb s1:1 s2:pa a0:pb a1:1",
  "cr": "sp:sp-48 s0:pb s1:1 s2:pa a0:cm",
  "rt": "ra sp s0 s1 s2 a0:e",
  "ng": "ra sp:sp-48 s0 s1:1 s2",
  "dp": "sp:sp-48 s0:pb s1:1 s2:pa a0:pa a1:pb a2:pc a5:bdp"
 },
 "facts": {
  "FF": ["rs: Ram (sp - 48) 48", "sp % 16 = 0", "48 ≤ sp", "sp ≤ mpInvmodBase ∨ mpInvmodBase + 172 ≤ sp - 48"],
  "SB": ["bytesT4 M (pb + 8) = BitVec.ofNat 32 sb", "Ram pb 24", "pb + 24 ≤ sp - 48 ∨ sp ≤ pb", "sb < 2 ^ 31"],
  "R2": ["bytesT8 M (sp - 8) = ra", "bytesT8 M (sp - 24) = s1"],
  "RF": ["bytesT8 M (sp - 8) = ra", "bytesT8 M (sp - 16) = s0", "bytesT8 M (sp - 24) = s1", "bytesT8 M (sp - 32) = s2",
         "bytesT8 M (sp - 40) = BitVec.ofNat 64 pc"],
  "UB": ["bytesT4 M pb = BitVec.ofNat 32 ub", "Ram pb 24", "ub < 2 ^ 31"],
  "DP": ["bytesT8 M (pb + 16) = BitVec.ofNat 64 bdp", "Ram pb 24"],
  "D0": ["bytesT4 M bdp = BitVec.ofNat 32 d0", "Ram bdp 4", "d0 < 2 ^ 31"]
 },
 "segs": [
  {"n": "neg", "at": "150c T", "to": "15a4", "pre": "ent", "post": "ng", "h": ["SB", "sb = 1"], "doc": "`b->sign == MP_NEG`: save `ra`, `s1`."},
  {"n": "negr", "at": "15a4", "pre": "ng", "post": "rt{e:=18446744073709551613}", "h": ["R2"], "doc": "Restore, `MP_VAL`."},
  {"n": "pro", "at": "150c F", "pre": "ent", "post": "cd", "h": ["SB", "sb ≠ 1"], "doc": "Save `ra`, `s0`–`s2`, `c`; `mp_cmp_d(b, 1)`."},
  {"n": "bad", "at": "1544 T", "pre": "cr", "post": "rt{e:=18446744073709551613}", "h": ["RF", "cm ≠ 1", "cm < 2 ^ 64"], "doc": "`mp_cmp_d(b, 1) != MP_GT`: `MP_VAL`."},
  {"n": "gt", "at": "1544 F F", "to": "1560", "pre": "cr", "post": "dp", "h": ["RF", "UB", "ub ≠ 0", "DP", "cm = 1"], "doc": "`MP_GT`: `b->used > 0`; `b->dp`."},
  {"n": "tf", "at": "1560 T", "to": "3338", "pre": "dp", "post": "ent", "h": ["RF", "D0", "d0 % 2 = 1"], "doc": "`b` odd: tail call `s_mp_invmod_fast(a, b, c)`."},
  {"n": "ts", "at": "1560 F", "to": "3670", "pre": "dp", "post": "ent", "h": ["RF", "D0", "d0 % 2 = 0"], "doc": "`b` even: tail call `s_mp_invmod_slow(a, b, c)`."}
 ]}
