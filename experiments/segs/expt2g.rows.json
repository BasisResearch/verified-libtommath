  {"n": "st", "at": "7744", "to": "7750", "pre": "mr", "post": "sd", "stu": ["2 ^ d"], "h": ["SW", "d < 28"], "by": "exact Tom.Machine.WV.Mask.sllw_one d (by omega)", "doc": "`a->dp[D] := 1 << d`."},
