{
 "fn": "mp_mul_2d", "mod": "MpMul2dIG", "src": "mmul2dig", "pfx": "m2dig", "imports": ["Tom.Machine.Kit.BitW"],
 "bv": "ra s0 s1", "nat": "sp pa b u al D d dp x r e y i j", "keep": "gp tp s2 s3 s4 s5 s6 s7 s8 s9 s10 s11", "h0": ["FF"],
 "regs": {
  "ent": "ra sp s0 s1 a0:pa a1:b a2:pa",
  "dv": "sp:sp-48 s0:pa s1:b a0:b a1:28",
  "d1": "sp:sp-48 s0:pa s1:b a0:D",
  "tl": "sp:sp-48 s0:pa s1:b a3:D",
  "gc": "sp:sp-48 s0:pa s1:b a0:pa a1:u+D+1",
  "m0": "sp:sp-48 s0:pa s1:b a0:e",
  "rt": "ra sp s0 s1 a0:e",
  "d2": "sp:sp-48 s0:pa s1:b a0:d",
  "kl": "sp:sp-48 s0:pa s1:b",
  "lc": "sp:sp-48 s0:pa s1:b a0:pa a1:D",
  "z0": "sp:sp-48 s0:pa s1:b a0:0",
  "lp": "sp:sp-48 s0:pa s1:b a0:d a1:2^d-1 t1:28-d a7:268435455 t3:dp a6:dp+4*x a2:x a5:r",
  "xl": "sp:sp-48 s0:pa s1:b t3:dp a3:u a5:r",
  "c3": "sp:sp-48 s0:pa s1:b t3:dp+4*u a5:r",
  "kc": "sp:sp-48 s0:pa s1:b a0:pa"
 },
 "facts": {
  "FF": ["rs: Ram (sp - 48) 48", "sp % 16 = 0", "48 ≤ sp", "sp ≤ mpMul2dBase ∨ mpMul2dBase + 336 ≤ sp - 48"],
  "UA": ["bytesT4 M pa = BitVec.ofNat 32 u", "u < 2 ^ 31", "Ram pa 24", "pa % 8 = 0", "pa + 24 ≤ sp - 48 ∨ sp ≤ pa",
         "pa + 24 ≤ mpMul2dBase ∨ mpMul2dBase + 336 ≤ pa"],
  "AL": ["bytesT4 M (pa + 4) = BitVec.ofNat 32 al", "al < 2 ^ 31"],
  "DP": ["bytesT8 M (pa + 16) = BitVec.ofNat 64 dp"],
  "RF": ["bytesT8 M (sp - 8) = ra", "bytesT8 M (sp - 16) = s0", "bytesT8 M (sp - 24) = s1"],
  "SP": ["bytesT8 M (sp - 40) = BitVec.ofNat 64 D"],
  "DG": ["bytesT4 M (dp + 4 * i) = BitVec.ofNat 32 y", "y < 268435456", "Ram (dp + 4 * i) 4"],
  "SW": ["Ram (dp + 4 * j) 4", "(dp + 4 * j) % 4 = 0", "dp + 4 * j + 4 ≤ mpMul2dBase ∨ mpMul2dBase + 336 ≤ dp + 4 * j",
         "dp + 4 * j + 4 ≤ sp - 48 ∨ sp ≤ dp + 4 * j", "dp + 4 * j + 4 ≤ pa ∨ pa + 24 ≤ dp + 4 * j"]
 },
 "segs": [
  {"n": "p1", "at": "1758 F T", "pre": "ent", "post": "dv", "h": ["b < 2 ^ 31"], "doc": "`b ≥ 0`: the frame, save `s0`, `s1`, `ra`; `a == c`: no copy; `__divdi3(b, 28)`."},
  {"n": "g", "at": "1790 F", "to": "17a4", "pre": "d1", "post": "tl", "h": ["UA", "AL", "D < 2 ^ 31", "u + D < al"], "doc": "Room: `a->used + D < a->alloc`."},
  {"n": "gg", "at": "1790 T", "pre": "d1", "post": "gc", "stu": ["D"], "h": ["UA", "AL", "D < 2 ^ 31", "al ≤ u + D", "u + D + 1 < 2 ^ 31"], "doc": "No room: spill `D`; `mp_grow(a, used + D + 1)`."},
  {"n": "gm", "at": "1894 F", "pre": "m0", "post": "rt", "h": ["RF", "SP", "e ≠ 0", "e < 2 ^ 64"], "doc": "`mp_grow` failed: restore, return its error."},
  {"n": "go", "at": "1894 T", "to": "17a4", "pre": "m0{e:=0}", "post": "tl", "h": ["SP"], "doc": "Grown: reload `D`."},
  {"n": "s", "at": "17a4 F", "pre": "tl", "post": "dv", "h": ["b < 28"], "doc": "`b < 28`: `__moddi3(b, 28)`."},
  {"n": "sz", "at": "17b8 T", "to": "183c", "pre": "d2", "post": "kl", "h": ["d = 0"], "doc": "`d = 0`: on to `mp_clamp`."},
  {"n": "sn", "at": "17b8 F", "to": "17c0", "pre": "d2", "post": "d2", "h": ["0 < d", "d < 28"], "doc": "`d != 0`: to the bit loop's setup."},
  {"n": "l", "at": "17a4 T", "pre": "tl", "post": "lc", "h": ["28 ≤ b", "b < 2 ^ 31"], "doc": "`b ≥ 28`: `mp_lshd(a, D)`."},
  {"n": "l2", "at": "1868 F", "pre": "z0", "post": "dv", "doc": "`mp_lshd` returned `MP_OKAY`: `__moddi3(b, 28)`."},
  {"n": "ln", "at": "1878 T", "to": "17c0", "pre": "d2", "post": "d2", "h": ["0 < d", "d < 28"], "doc": "`d != 0`: to the bit loop's setup."},
  {"n": "lz", "at": "1878 F", "to": "183c", "pre": "d2", "post": "kl", "h": ["d = 0"], "doc": "`d = 0`: on to `mp_clamp`."},
  {"n": "u0", "at": "17c0 T", "to": "183c", "pre": "d2", "post": "kl", "h": ["UA", "u = 0"], "doc": "`a->used = 0`: skip the bit loop."},
  {"n": "i", "at": "17c0 F", "to": "17f4", "pre": "d2", "post": "lp{x:=0, r:=0}", "h": ["UA", "DP", "0 < u", "0 < d", "d < 28"], "eqs": ["BitW.mask_ofNat d (by omega)"], "doc": "The masks; enter the bit loop."},
  {"n": "lp", "at": "17f4 T", "to": "17f4", "pre": "lp", "post": "lp{x:=x+1, r:=shlHi d y}", "stu": ["shlLo d y + r"], "h": ["DG{i:=x}", "SW{j:=x}", "UA", "0 < d", "d < 28", "r < 2 ^ d", "x + 1 < u"], "by": "first | exact BitW.srl_and_mask y d (by omega) (by simp only [radix, Layout.digitBits]; omega) | exact BitW.shl_or_mask y r d (by omega) (by simp only [radix, Layout.digitBits]; omega) (by omega)", "doc": "The bit loop's back edge: digit `x := shlLo d y + r`, carry `shlHi d y`."},
  {"n": "lx", "at": "17f4 F", "to": "1824", "pre": "lp", "post": "xl{r:=shlHi d y}", "stu": ["shlLo d y + r"], "h": ["DG{i:=x}", "SW{j:=x}", "UA", "0 < d", "d < 28", "r < 2 ^ d", "x + 1 = u"], "by": "first | exact BitW.srl_and_mask y d (by omega) (by simp only [radix, Layout.digitBits]; omega) | exact BitW.shl_or_mask y r d (by omega) (by simp only [radix, Layout.digitBits]; omega) (by omega)", "doc": "The bit loop's last iteration."},
  {"n": "cz", "at": "1824 T", "to": "183c", "pre": "xl{r:=0}", "post": "kl", "doc": "No last carry: on to `mp_clamp`."},
  {"n": "cn1", "at": "1824 F", "to": "1838", "pre": "xl", "post": "c3", "stu": ["u + 1"], "h": ["UA", "0 < r", "r < 2 ^ 64", "u + 1 < 2 ^ 31"], "doc": "A last carry: `a->used := u + 1`."},
  {"n": "cn2", "at": "1838", "to": "183c", "pre": "c3", "post": "kl", "h": ["SW{j:=u}"], "doc": "`a->dp[u] := r`."},
  {"n": "k", "at": "183c", "pre": "kl", "post": "kc", "doc": "`mp_clamp(a)`."},
  {"n": "e", "at": "1844", "pre": "kl", "post": "rt{e:=0}", "h": ["RF"], "doc": "Restore, return `MP_OKAY`."}
 ]}
