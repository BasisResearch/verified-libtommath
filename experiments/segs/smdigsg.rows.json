  {"n": "il", "at": "41e8 T", "to": "41d8", "pre": "m2", "post": "ih{iy:=iy+1, c:=(y*x+tv+c)/268435456}", "st": ["(y * x + tv + c) % 268435456"], "h": ["TA", "DG{a:=tdp+4*(ix+iy), x:=tv}", "ix + iy < dg", "iy + 1 < n", "n ≤ dg", "y * x < 2 ^ 56", "c < 2 ^ 30"], "doc": "`*tmpt++ := r & MP_MASK`, `u := r >> 28`; the inner back edge."},
