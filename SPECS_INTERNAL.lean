theorem _root_.Specs.s_mp_add_correct_cb {p : P} {m : Mem} {v : Abi} {outp : Array String}
    {ra : BitVec 64}
    (ra_al : ra.toNat % 4 = 0)
    (stk_al : p.sp % 16 = 0)
    (stk_lo : heapEnd + F ≤ p.sp)
    (stk_hi : p.sp ≤ 0x100000000)
    (sa : p.a.Shape)
    (sb : p.b.Shape)
    (size_lt : max p.a.used p.b.used + 1 < 2 ^ 31)
    (apos : 0 < p.a.alloc)
    (bpos : 0 < p.b.alloc)
    (coff : OffHeap p.pb 24)
    (sound : Sound (lay p) isW)
    (w_stk : Ram (p.sp - F) F)
    (w_aS : Hdr m p.pa p.adp p.a)
    (w_aD : Dig m p.adp p.a.alloc p.a.digit)
    (w_bS : Hdr m p.pb p.bdp p.b)
    (w_bD : Dig m p.bdp p.b.alloc p.b.digit)
    (w_code : Img m)
    (heap : AHeap m (digBlk p.bdp p.b :: p.H))
    (off : ∀ (r : R), Off (lay p r) (digBlk p.bdp p.b :: p.H)) :
    Triple
      (At 0x8000219c#64
        [(1, ra), (2, BitVec.ofNat 64 p.sp), (3, gpV), (10, BitVec.ofNat 64 p.pa), (11, BitVec.ofNat 64 p.pb),
          (12, BitVec.ofNat 64 p.pb)]
        m v.keep outp)
      fun cf =>
      ∃ x M,
        At ra
            [(1, ra),
              (10,
                match x with
                | none => MpGrow.memBV
                | some val => 0#64)]
            M v.keep outp cf ∧
          (match x with
            | none => p.b.alloc < max p.a.used p.b.used + 1
            | some (fst, x) => SAddPost p.a p.b (sAddIn p.a p.b p.b) x) ∧
            HPost (lay p) [R.stk, R.bS, R.bD] R.bD (out p x) (site' p x) (digBlk p.bdp p.b :: p.H)
              (match x with
              | none => digBlk p.bdp p.b :: p.H
              | some (q, x) => (q, 4 * x.alloc) :: p.H)
              m M :=
  have H : Tom.Machine.Api.SAddGB.Statement := Tom.Machine.Fn.SAddGBG5.correct
  @H p m v outp ra ra_al ⟨⟨stk_al, stk_lo, stk_hi⟩, sa, sb, size_lt, apos, bpos, coff⟩ sound
      (fun r => match r with
        | .stk => ⟨trivial, w_stk⟩
        | .aS => ⟨Iv.sub_self _, w_aS⟩
        | .aD => ⟨Iv.sub_self _, w_aD⟩
        | .bS => ⟨Iv.sub_self _, w_bS⟩
        | .bD => ⟨Iv.sub_self _, w_bD⟩
        | .code => ⟨Iv.sub_self _, w_code⟩)
      heap off
end Tom.Machine.Api.SAddGB

