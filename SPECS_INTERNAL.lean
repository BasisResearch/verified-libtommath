    {ra : BitVec 64}
    (ra_al : ra.toNat % 4 = 0)
    (stk_al : p.sp % 16 = 0)
    (stk_lo : heapEnd + F ≤ p.sp)
    (stk_hi : p.sp ≤ 0x100000000)
    (va : p.a.Valid)
    (vb : p.b.Valid)
    (bnz : 0 < p.b.used)
    (h_bits : Layout.digitBits * p.b.used < 2 ^ 31)
    (au : p.a.used + 3 < 2 ^ 30)
    (apos : 0 < p.a.alloc)
    (aoff : OffHeap p.pa 24)
    (boff : OffHeap p.pb 24)
    (bblk : digBlk p.bdp p.b ∈ p.H)
    (sound : Sound (lay p) isW)
    (w_stk : Ram (p.sp - F) F)
    (w_aS : Hdr m p.pa p.adp p.a)
    (w_aD : Dig m p.adp p.a.alloc p.a.digit)
    (w_bS : Hdr m p.pb p.bdp p.b)
    (w_bD : Dig m p.bdp p.b.alloc p.b.digit)
    (w_code : Img m)
    (heap : AHeap m (digBlk p.adp p.a :: p.H))
    (off : ∀ (r : R), Off (lay p r) (digBlk p.adp p.a :: p.H)) :
