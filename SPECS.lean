    (mu : MpOwn m p.H p.pu p.udp p.mu) (fx : Fits p.x) (xz : p.x.sign = Layout.mpZpos)
    (nz : p.n.sign = Layout.mpZpos) (muz : p.mu.sign = Layout.mpZpos) (k1 : 0 < p.n.used)
    (fn : Layout.digitBits * (p.n.used + 1) < 2 ^ 31) (xu : p.x.used ≤ 2 * p.n.used)
