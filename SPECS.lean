    ApiTripleS m v outp ra s0 entry sp [pa, b, pc, 0] 0#64 fun c' M =>
      (c'.Valid ∧ c'.mag = a.mag / 2 ^ b) ∧ Post m sp pa adp pc cdp a b c c' M :=
