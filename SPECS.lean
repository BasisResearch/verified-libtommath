    (hmu : p.mu.mag = radix ^ (2 * p.n.used) / p.n.mag) (hx : p.x.mag < radix ^ (2 * p.n.used)) :
    ApiTriple m v outp ra entry p.sp [p.px, p.pn, p.pu] okRet fun o M =>
