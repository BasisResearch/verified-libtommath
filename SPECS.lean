namespace Tom.Machine.Api.AddD
open Tom.Machine.Api.Two

/-- **`mp_add_d(a, b, c)`**: `c ← a + b` for a digit `b`, `c` with room. -/
theorem _root_.Specs.mp_add_d {sp pa adp pc cdp : Nat} {a c : MpInt} {b : Nat}
    {s0 : BitVec 64} (cv : ConvS m ra sp 128) (sound : Sound (lay 128 sp pa adp pc cdp a c) isW)
    (ha : MpVal m pa adp a) (hc : MpOut m pc cdp c) (hb : b < radix) (room : a.used + 1 ≤ c.alloc) :
    ApiTripleS m v outp ra s0 entry sp [pa, b, pc] 0#64 fun c' M =>
      (c'.Valid ∧ c'.val = a.val + b) ∧ Post 128 m sp pa adp pc cdp a b c c' M :=
  ApiTripleS.of (Fn.AddD.correct ⟨ha.mpAt, hc.mpAt, ha.valid, hc.shape, hb, ha.geom, hc.geom, room,
    cv.stk.ram, cv.stk.al, cv.sp_ge, cv.ra_al, cv.img, sound⟩) fun _ _ h =>
    AddDPost.spec ha.valid hb room hc.shape.alloc_lt h.addd

end Tom.Machine.Api.AddD

namespace Tom.Machine.Fn.Clamp
open LeanRV64DExecutable.Functions Tom.Machine.Seg

/-- **`mp_clamp(a)`**: `a.used` lowered past the high zero digits, `-0` made `+0` (`Post`:
`ClampPost`, `a'` valid with `a`'s magnitude); `PreU`: `a` in memory with `ShapeU` (digits below
the radix, not yet clamped), its struct off the code. -/
theorem _root_.Specs.mp_clamp {p dp : Nat} {a : MpInt} (hra : ra.toNat % 4 = 0) (pre : PreU m p dp a) :
    Triple (At entry ((1, ra) :: callArgs 10 [p]) m v.keep outp) fun cf =>
      ∃ a' M, At ra [(1, ra), (10, BitVec.ofNat 64 p)] M v.keep outp cf ∧ Post m p dp a a' M :=
  correctU ra v outp p dp a m hra pre

end Tom.Machine.Fn.Clamp

namespace Tom.Machine.Api.MpClear

/-- **`mp_clear(a)`**: `a`'s digit block freed, `a` the cleared `mp_int` (`dp = NULL`; `Post`;
`void`). `Pre`: `a` at `pa` with its digits the front live block of the heap, the allocator's
context. -/
theorem _root_.Specs.mp_clear {H : List (Nat × Nat)} {sp pa adp : Nat} {a : MpInt}
    (pre : Pre m v H sp pa adp a ra) :
    Triple (At Fn.MpClear.entry ((1, ra) :: callArgs 10 [pa]) m v.keep outp) fun cf =>
      ∃ M, At ra [(1, ra)] M v.keep outp cf ∧ Post m H sp pa adp a M :=
  Fn.MpClear.correct pre

end Tom.Machine.Api.MpClear

namespace Tom.Machine.Api.MpClearMulti
open Tom.Machine.Api.Multi

/-- **`mp_clear_multi(a₁, …, aₖ, NULL)`**: `mp_clear` of each (`Post`; `void`). -/
theorem _root_.Specs.mp_clear_multi {H : List (Nat × Nat)} {sp : Nat} {xs : List Arg}
    (pre : Pre m v H sp xs ra) :
    Triple (At Fn.MpClearMulti.entry ((1, ra) :: argRegs 0 (args (ptrs xs))) m v.keep outp) fun cf =>
      ∃ M, At ra [(1, ra)] M v.keep outp cf ∧ Post m H sp xs M :=
  Fn.MpClearMulti.correct pre

end Tom.Machine.Api.MpClearMulti

namespace Tom.Machine.Api.CmpS

/-- **`mp_cmp(a, b)`**: `MP_LT`/`MP_EQ`/`MP_GT` as `a < b`, `a = b`, `a > b`. -/
theorem _root_.Specs.mp_cmp {pa adp pb bdp : Nat} {a b : MpInt}
    (cv : ConvL m ra) (ha : MpVal m pa adp a) (hb : MpVal m pb bdp b) :
    ApiPure m v outp ra entry [pa, pb] (BitVec.ofInt 64 (ordCode (compare a.val b.val))) := by
  rw [← cmpS_spec ha.valid hb.valid]
  exact Fn.CmpS.correct ⟨ha.mpAt, hb.mpAt, ha.valid, hb.valid, ha.geom, hb.geom, cv.ra_al, cv.img⟩

end Tom.Machine.Api.CmpS

namespace Tom.Machine.Api.CmpD

/-- **`mp_cmp_d(a, b)`**: `a` against the digit `b`. -/
theorem _root_.Specs.mp_cmp_d {pa adp : Nat} {a : MpInt} {b : Nat}
    (cv : ConvL m ra) (ha : MpVal m pa adp a) (pos : 0 < a.alloc) (hb : b < radix) :
    ApiPure m v outp ra entry [pa, b] (BitVec.ofInt 64 (ordCode (compare a.val b))) := by
  rw [← cmpD_spec ha.valid hb]
  exact Fn.CmpD.correct ⟨ha.mpAt, ha.valid, ha.geom, pos, hb, cv.ra_al, cv.img⟩

end Tom.Machine.Api.CmpD

namespace Tom.Machine.Fn.CmpMag

/-- **`mp_cmp_mag(a, b)`**: `|a|` against `|b|`. -/
theorem _root_.Specs.mp_cmp_mag {pa adp pb bdp : Nat} {a b : MpInt}
    (cv : ConvL m ra) (ha : MpVal m pa adp a) (hb : MpVal m pb bdp b) :
    ApiPure m v outp ra 0x80000764#64 [pa, pb] (BitVec.ofInt 64 (ordCode (compare a.mag b.mag))) := by
  rw [← cmpMag_eq ha.valid hb.valid]
  exact correctS ra v outp pa adp pb bdp a b m cv.ra_al
    ⟨ha.mpAt, hb.mpAt, ha.valid.toShape, hb.valid.toShape, ha.geom, hb.geom, cv.img.mpCmpMag⟩

end Tom.Machine.Fn.CmpMag

namespace Tom.Machine.Api.CntLsb

/-- **`mp_cnt_lsb(a)`**: the number of trailing zero bits of `|a|` (`0` for `a = 0`). -/
theorem _root_.Specs.mp_cnt_lsb {pa adp : Nat} {a : MpInt}
    (cv : ConvL m ra) (ha : MpVal m pa adp a) (fa : Fits a) :
    ApiPure m v outp ra entry [pa] (BitVec.ofNat 64 (Gcd.lsb a.mag)) := by
  rw [← (GcdStep.cntLsb_eq ha.valid).1]
  exact Fn.CntLsb.correct ⟨ha.mpAt, ha.valid, ha.geom, fa, cv.ra_al, cv.img⟩

end Tom.Machine.Api.CntLsb

namespace Tom.Machine.Api.CountBits

/-- **`mp_count_bits(a)`**: the bit length of `|a|` (`0` for `a = 0`). -/
theorem _root_.Specs.mp_count_bits {pa adp : Nat} {a : MpInt}
    (cv : ConvL m ra) (ha : MpVal m pa adp a) (fa : Fits a) :
    ApiPure m v outp ra entry [pa] (BitVec.ofNat 64 (bitLen a.mag)) := by
  rw [← countBits_spec ha.valid]
  exact Fn.CountBits.correct ⟨ha.mpAt, ha.valid, ha.geom, fa, cv.ra_al, cv.img⟩

end Tom.Machine.Api.CountBits

namespace Tom.Machine.Api.MpCopyG

/-- **`mp_copy(a, b)`**: `b ← a`, growing `b`; `MP_MEM` only when `b` had to grow. -/
theorem _root_.Specs.mp_copy {p : P} (cv : Conv m ra p.sp F (hin p)) (sound : Sound (lay p) isW)
    (a : MpOwn m p.H p.pa p.adp p.a) (b : MpOut m p.pb p.bdp p.b) (ne : p.pa ≠ p.pb) :
    ApiTriple m v outp ra entry p.sp [p.pa, p.pb] optRet fun x M =>
      OptRes x (p.b.alloc < p.a.used) (fun b' => b'.Valid ∧ b'.val = p.a.val) ∧
