theorem _root_.Specs.mp_mulmod_correct {p : P} {m : Mem} {v : Abi} {outp : Array String}
    {ra : BitVec 64}
    (ra_al : ra.toNat % 4 = 0)
    (stk_al : p.sp % 16 = 0)
    (stk_lo : heapEnd + (2864 + 8 * (p.a.used + p.b.used)) ≤ p.sp)
    (stk_hi : p.sp ≤ 0x100000000)
    (mul : ∀ (p : MpMul.P) {m : Mem} {v : Abi} {outp : Array String} {ra : BitVec 64},
        ra.toNat % 4 = 0 →
          MpMul.Res p →
            Sound (MpMul.lay p) MpMul.isW →
              Bundle (MpMul.lay p) (MpMul.kind p) m →
                AHeap m (digBlk p.cdp p.c :: p.H) →
                  (∀ (r : MpMul.R), Off (MpMul.lay p r) (digBlk p.cdp p.c :: p.H)) →
                    Triple
                      (At 0x800018a8#64
                        [(1, ra), (2, BitVec.ofNat 64 p.sp), (3, gpV), (10, BitVec.ofNat 64 p.pa), (11, BitVec.ofNat 64 p.pb),
                          (12, BitVec.ofNat 64 p.pc)]
                        m v.keep outp)
                      fun cf =>
                      ∃ x M,
                        At ra [(1, ra), (10, if x.fst = true then 0#64 else MpInit.memBV)] M v.keep outp cf ∧
                          (match x with
                            | (ok, fst, c') => MpMul.Out p ok c') ∧
                            HPost (MpMul.lay p) [MpMul.R.stk, MpMul.R.cS, MpMul.R.cD] MpMul.R.cD (MpMul.out p x)
                              (MpMul.site' p x) (digBlk p.cdp p.c :: p.H)
                              (match x with
                              | (fst, q, c') => (q, 4 * c'.alloc) :: p.H)
                              m M)
    (va : p.a.Valid)
    (vb : p.b.Valid)
    (uab : p.a.used + p.b.used + 3 < 2 ^ 30)
    (apos : 0 < p.a.alloc)
    (bpos : 0 < p.b.alloc)
    (vc : p.c.Valid)
    (c0 : 0 < p.c.used)
    (cz : p.c.sign = Layout.mpZpos)
    (cbits : Layout.digitBits * p.c.used < 2 ^ 31)
    (sd : p.d.Shape)
    (dpos : 0 < p.d.alloc)
    (aoff : OffHeap p.pa 24)
    (boff : OffHeap p.pb 24)
    (coff : OffHeap p.pc 24)
    (doff : OffHeap p.pd 24)
    (cblk : digBlk p.cdp p.c ∈ p.H)
    (sound : Sound (lay p) isW)
    (w_stk : Ram (p.sp - (2864 + 8 * (p.a.used + p.b.used))) (2864 + 8 * (p.a.used + p.b.used)))
    (w_aS : Hdr m p.pa p.adp p.a)
    (w_aD : Dig m p.adp p.a.alloc p.a.digit)
    (w_bS : Hdr m p.pb p.bdp p.b)
    (w_bD : Dig m p.bdp p.b.alloc p.b.digit)
    (w_cS : Hdr m p.pc p.cdp p.c)
    (w_cD : Dig m p.cdp p.c.alloc p.c.digit)
    (w_dS : Hdr m p.pd p.ddp p.d)
    (w_dD : Dig m p.ddp p.d.alloc p.d.digit)
    (w_kc : Dig m 0x800194fc 1 fun x => 80)
    (w_tc : Dig m 0x800194f4 1 fun x => 350)
    (w_code : Img m)
    (heap : AHeap m (digBlk p.ddp p.d :: p.H))
    (off : ∀ (r : R), Off (lay p r) (digBlk p.ddp p.d :: p.H)) :
    Triple
      (At 0x80005d90#64
        [(1, ra), (2, BitVec.ofNat 64 p.sp), (3, gpV), (10, BitVec.ofNat 64 p.pa), (11, BitVec.ofNat 64 p.pb),
          (12, BitVec.ofNat 64 p.pc), (13, BitVec.ofNat 64 p.pd)]
        m v.keep outp)
      fun cf =>
      ∃ x M,
        At ra
            [(1, ra),
              (10,
                match x with
                | Out.mem d' => MpInit.memBV
                | Out.ok q d' => 0#64)]
            M v.keep outp cf ∧
          (match x with
            | Out.mem d' =>
              d' =
                have __src := p.d;
                { used := __src.used, alloc := __src.alloc, sign := d'.sign, digits := __src.digits }
            | Out.ok q d' => Reduce.MulmodPost p.a p.b p.c d') ∧
            HPost (lay p) [R.stk, R.dS, R.dD] R.dD (out p x) (site' p x) (digBlk p.ddp p.d :: p.H)
              (match x with
              | Out.ok q d' => (q, 4 * d'.alloc) :: p.H
              | Out.mem d' => digBlk p.ddp p.d :: p.H)
              m M :=
  have H : Tom.Machine.Api.MpMulmod.Statement := Tom.Machine.Fn.MpMulmodG5.correct
  @H p m v outp ra ra_al ⟨⟨stk_al, stk_lo, stk_hi⟩, mul, va, vb, uab, apos, bpos, vc, c0, cz, cbits,
      sd, dpos, aoff, boff, coff, doff, cblk⟩ sound (fun r => match r with
        | .stk => ⟨trivial, w_stk⟩
        | .aS => ⟨Iv.sub_self _, w_aS⟩
        | .aD => ⟨Iv.sub_self _, w_aD⟩
        | .bS => ⟨Iv.sub_self _, w_bS⟩
        | .bD => ⟨Iv.sub_self _, w_bD⟩
        | .cS => ⟨Iv.sub_self _, w_cS⟩
        | .cD => ⟨Iv.sub_self _, w_cD⟩
        | .dS => ⟨Iv.sub_self _, w_dS⟩
        | .dD => ⟨Iv.sub_self _, w_dD⟩
        | .kc => ⟨Iv.sub_self _, w_kc⟩
        | .tc => ⟨Iv.sub_self _, w_tc⟩
        | .code => ⟨Iv.sub_self _, w_code⟩)
      heap off
end Tom.Machine.Api.MpMulmod

