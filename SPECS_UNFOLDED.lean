theorem _root_.Specs.mp_exptmod_correct {p : P} {m : Mem} {v : Abi} {outp : Array String}
    {ra : BitVec 64}
    (ra_al : ra.toNat % 4 = 0)
    (stk_al : p.sp % 16 = 0)
    (stk_lo : heapEnd + F p ≤ p.sp)
    (stk_hi : p.sp ≤ 0x100000000)
    (vg : p.g.Valid)
    (vx : p.x.Valid)
    (vn : p.n.Valid)
    (sy : p.y.Shape)
    (nz : p.n.sign = Layout.mpZpos)
    (xbits : Layout.digitBits * p.x.used < 2 ^ 31)
    (nbits : Layout.digitBits * p.n.used < 2 ^ 31)
    (gu : p.g.used + p.n.used + 3 < 2 ^ 30)
    (mode : p.mode < 2 ^ 31)
    (gpos : 0 < p.g.alloc)
    (xpos : 0 < p.x.alloc)
    (npos : 0 < p.n.alloc)
    (ypos : 0 < p.y.alloc)
    (goff : OffHeap p.pg 24)
    (xoff : OffHeap p.px 24)
    (noff : OffHeap p.pn 24)
    (yoff : OffHeap p.py 24)
    (gblk : digBlk p.gdp p.g ∈ p.H)
    (nblk : digBlk p.ndp p.n ∈ p.H)
    (arith_gt1 : 1 < p.n.mag)
    (arith_bits : Layout.digitBits * (2 * p.n.used + 1) < 2 ^ 31)
    (arith_r2k : isReduce2k p.n = 1 → p.n.mag + (2 ^ Mont.nbits p.n.mag - p.n.mag) % radix = 2 ^ Mont.nbits p.n.mag)
    (sound : Sound (lay (F p) p) isW)
    (w_stk : Ram (p.sp - F p) (F p))
    (w_gS : Hdr m p.pg p.gdp p.g)
    (w_gD : Dig m p.gdp p.g.alloc p.g.digit)
    (w_xS : Hdr m p.px p.xdp p.x)
    (w_xD : Dig m p.xdp p.x.alloc p.x.digit)
    (w_nS : Hdr m p.pn p.ndp p.n)
    (w_nD : Dig m p.ndp p.n.alloc p.n.digit)
    (w_yS : Hdr m p.py p.ydp p.y)
    (w_yD : Dig m p.ydp p.y.alloc p.y.digit)
    (w_ks : Dig m 0x800194f8 1 fun x => 120)
    (w_ts : Dig m 0x800194f0 1 fun x => 400)
    (w_kc : Dig m 0x800194fc 1 fun x => 80)
    (w_tc : Dig m 0x800194f4 1 fun x => 350)
    (w_code : Img m)
    (heap : AHeap m (digBlk p.ydp p.y :: p.H))
    (off : ∀ (r : R), Off (lay (F p) p r) (digBlk p.ydp p.y :: p.H)) :
    Triple
      (At 0x80000e94#64
        [(1, ra), (2, BitVec.ofNat 64 p.sp), (3, gpV), (10, BitVec.ofNat 64 p.pg), (11, BitVec.ofNat 64 p.px),
          (12, BitVec.ofNat 64 p.pn), (13, BitVec.ofNat 64 p.py)]
        m v.keep outp)
      fun cf =>
      ∃ x M,
        At ra
            [(1, ra),
              (10,
                match x with
                | Out.err r => BitVec.ofInt 64 r
                | Out.ok q y' => 0#64)]
            M v.keep outp cf ∧
          (match x with
            | Out.err r => r = Layout.mpMem ∨ ExptmodPost p.g p.x p.n p.y p.y r
            | Out.ok q y' => ExptmodPost p.g p.x p.n p.y y' Layout.mpOkay) ∧
            HPost (lay (F p) p) [R.stk, R.yS, R.yD] R.yD (out p x) (site' (F p) p x) (digBlk p.ydp p.y :: p.H)
              (match x with
              | Out.ok q y' => (q, 4 * y'.alloc) :: p.H
              | Out.err r => digBlk p.ydp p.y :: p.H)
              m M :=
  have H : Tom.Machine.Api.MpExptmod.Statement := Tom.Machine.Fn.MpExptmod.correct
  @H p m v outp ra ra_al ⟨⟨⟨stk_al, stk_lo, stk_hi⟩, vg, vx, vn, sy, nz, xbits, nbits, gu, mode,
      gpos, xpos, npos, ypos, goff, xoff, noff, yoff, gblk, nblk⟩, ⟨arith_gt1, arith_bits,
      arith_r2k⟩⟩ sound (fun r => match r with
        | .stk => ⟨trivial, w_stk⟩
        | .gS => ⟨Iv.sub_self _, w_gS⟩
        | .gD => ⟨Iv.sub_self _, w_gD⟩
        | .xS => ⟨Iv.sub_self _, w_xS⟩
        | .xD => ⟨Iv.sub_self _, w_xD⟩
        | .nS => ⟨Iv.sub_self _, w_nS⟩
        | .nD => ⟨Iv.sub_self _, w_nD⟩
        | .yS => ⟨Iv.sub_self _, w_yS⟩
        | .yD => ⟨Iv.sub_self _, w_yD⟩
        | .ks => ⟨Iv.sub_self _, w_ks⟩
        | .ts => ⟨Iv.sub_self _, w_ts⟩
        | .kc => ⟨Iv.sub_self _, w_kc⟩
        | .tc => ⟨Iv.sub_self _, w_tc⟩
        | .code => ⟨Iv.sub_self _, w_code⟩)
      heap off
end Tom.Machine.Api.MpExptmod

