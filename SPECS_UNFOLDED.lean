  have H : Tom.Machine.Api.SubD.Statement := Tom.Machine.Fn.SubD.correct
  @H m v outp sp pa adp pc cdp a b c ra s0 ⟨ra_, rc, va, sc, hb, ga, gc, room, rs, sp_al, sp_ge,
      ra_al, img, h_lay⟩
end Tom.Machine.Api.SubD

namespace Tom
