    (bblk : Heap.digBlk p.bdp p.b ∈ p.H)
    (apos : 0 < p.a.alloc)
    (bpos : 0 < p.b.alloc)
    (aoff : Heap.OffHeap p.pa 24)
    (boff : Heap.OffHeap p.pb 24)
    (coff : Heap.OffHeap p.pc 24)
    (sound : Sound (lay p) isW)
    (w_stk : Ram (p.sp - F) F)
    (w_aS : Hdr m p.pa p.adp p.a)
    (w_aD : Dig m p.adp p.a.alloc p.a.digit)
    (w_bS : Hdr m p.pb p.bdp p.b)
    (w_bD : Dig m p.bdp p.b.alloc p.b.digit)
    (w_cS : Hdr m p.pc p.cdp p.c)
    (w_cD : Dig m p.cdp p.c.alloc p.c.digit)
    (w_code : Img m)
    (heap : AHeap m (Heap.digBlk p.cdp p.c :: p.H))
    (off : ∀ (r : R), Off (lay p r) (Heap.digBlk p.cdp p.c :: p.H)) :
    Vsa.Logic.Triple
      (At 0x8000150c#64
        [(1, ra), (2, BitVec.ofNat 64 p.sp), (3, Alloc.gpV), (10, BitVec.ofNat 64 p.pa), (11, BitVec.ofNat 64 p.pb),
          (12, BitVec.ofNat 64 p.pc)]
        m v.keep outp)
      fun cf =>
      ∃ x M,
        At ra
            [(1, ra),
              (10,
                match x with
                | Out.err r => BitVec.ofInt 64 r
                | Out.ok q c' => 0#64)]
            M v.keep outp cf ∧
