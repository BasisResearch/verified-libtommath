    (apos : 0 < p.a.alloc)
    (aoff : OffHeap p.pa 24)
    (sound : Sound (lay p) isW)
    (w_stk : Ram (p.sp - F) F)
    (w_aS : Hdr m p.pa p.adp p.a)
    (w_aD : Dig m p.adp p.a.alloc p.a.digit)
    (w_code : Img m)
    (heap : AHeap m (digBlk p.adp p.a :: p.H))
    (off : ∀ (r : R), Off (lay p r) (digBlk p.adp p.a :: p.H)) :
    Triple
      (At 0x800076d4#64
        [(1, ra), (2, BitVec.ofNat 64 p.sp), (3, gpV), (10, BitVec.ofNat 64 p.pa), (11, BitVec.ofNat 64 p.b)] m v.keep outp)
      fun cf =>
      ∃ x M,
        At ra
            [(1, ra),
              (10,
                match x with
                | none => MpGrow.memBV
                | some val => 0#64)]
            M v.keep outp cf ∧
          (match x with
            | none => p.a.alloc < p.b / Layout.digitBits + 1
            | some (q, a') => Ok p q a') ∧
            HPost (lay p) [R.stk, R.aS, R.aD] R.aD (out p x) (site' p x) (digBlk p.adp p.a :: p.H)
              (match x with
