theorem _root_.Specs.mp_dr_reduce_correct {p : P} {m : Mem} {v : Abi} {outp : Array String}
    {ra : BitVec 64}
    (ra_al : ra.toNat % 4 = 0)
    (stk_al : p.sp % 16 = 0)
    (stk_lo : heapEnd + F ≤ p.sp)
    (stk_hi : p.sp ≤ 0x100000000)
    (va : p.a.Valid)
    (vn : p.n.Valid)
    (npos : 0 < p.n.mag)
    (d_lt : p.d < radix)
    (x_lt : p.a.mag < radix ^ (2 * p.n.used))
    (apos : 0 < p.a.alloc)
    (aoff : OffHeap p.pa 24)
    (noff : OffHeap p.pn 24)
    (sound : Sound (lay p) MpReduce2k.isW)
    (w_stk : Ram (p.sp - F) F)
    (w_aS : Hdr m p.pa p.adp p.a)
    (w_aD : Dig m p.adp p.a.alloc p.a.digit)
    (w_nS : Hdr m p.pn p.ndp p.n)
    (w_nD : Dig m p.ndp p.n.alloc p.n.digit)
    (w_code : Img m)
    (heap : AHeap m (digBlk p.adp p.a :: p.H))
    (off : ∀ (r : R), Off (lay p r) (digBlk p.adp p.a :: p.H)) :
    Triple
      (At 0x800055e4#64
        [(1, ra), (2, BitVec.ofNat 64 p.sp), (3, gpV), (10, BitVec.ofNat 64 p.pa), (11, BitVec.ofNat 64 p.pn),
          (12, BitVec.ofNat 64 p.d)]
        m v.keep outp)
      fun cf =>
      ∃ x M,
        At ra [(1, ra), (10, if x.fst = true then 0#64 else MpInit.memBV)] M v.keep outp cf ∧
          ReduxG.Out p (lay p R.aD) (DrReducePost p.a p.n p.d) x ∧
            HPost (lay p) [R.stk, R.aS, R.aD] R.aD (out p x) (site' p x) (digBlk p.adp p.a :: p.H)
              (match x with
              | (fst, q, a') => (q, 4 * a'.alloc) :: p.H)
              m M :=
  have H : Tom.Machine.Api.DrReduceG.Statement := Tom.Machine.Fn.DrReduceGG5.correct
  @H p m v outp ra ra_al ⟨⟨stk_al, stk_lo, stk_hi⟩, va, vn, npos, d_lt, x_lt, apos, aoff, noff⟩
      sound (fun r => match r with
        | .stk => ⟨trivial, w_stk⟩
        | .aS => ⟨Iv.sub_self _, w_aS⟩
        | .aD => ⟨Iv.sub_self _, w_aD⟩
        | .nS => ⟨Iv.sub_self _, w_nS⟩
        | .nD => ⟨Iv.sub_self _, w_nD⟩
        | .code => ⟨Iv.sub_self _, w_code⟩)
      heap off
end Tom.Machine.Api.DrReduceG

