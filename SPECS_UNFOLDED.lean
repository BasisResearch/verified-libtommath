            HPost (lay p) [R.stk, R.cS, R.cD] R.cD (out p x) (site' p x) (Heap.digBlk p.cdp p.c :: p.H)
              (match x with
              | Out.ok q c' => (q, 4 * c'.alloc) :: p.H
              | Out.err r => Heap.digBlk p.cdp p.c :: p.H)
              m M :=
  have H : Tom.Machine.Api.MpInvmodG.Statement := Tom.Machine.Fn.Invmod.correctG
  @H p m v outp ra ra_al ⟨⟨stk_al, stk_lo, stk_hi⟩, va, vb, au, cpos, ablk, bblk, apos, bpos, aoff,
      boff, coff⟩ sound (fun r => match r with
        | .stk => ⟨trivial, w_stk⟩
        | .aS => ⟨Iv.sub_self _, w_aS⟩
        | .aD => ⟨Iv.sub_self _, w_aD⟩
        | .bS => ⟨Iv.sub_self _, w_bS⟩
        | .bD => ⟨Iv.sub_self _, w_bD⟩
        | .cS => ⟨Iv.sub_self _, w_cS⟩
        | .cD => ⟨Iv.sub_self _, w_cD⟩
        | .code => ⟨Iv.sub_self _, w_code⟩)
