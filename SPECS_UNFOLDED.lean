    (stk_al : p.sp % 16 = 0)
    (stk_lo : heapEnd + F ≤ p.sp)
    (stk_hi : p.sp ≤ 0x100000000)
    (va : p.a.Valid)
    (vb : p.b.Valid)
    (sc : p.c.Shape)
    (abits : Layout.digitBits * p.a.used < 2 ^ 31)
    (bbits : Layout.digitBits * p.b.used < 2 ^ 31)
    (room : max p.a.used p.b.used + 1 ≤ p.c.alloc)
    (ablk : digBlk p.adp p.a ∈ p.H)
    (bblk : digBlk p.bdp p.b ∈ p.H)
    (apos : 0 < p.a.alloc)
    (bpos : 0 < p.b.alloc)
    (aoff : OffHeap p.pa 24)
    (boff : OffHeap p.pb 24)
    (coff : OffHeap p.pc 24)
    (sound : Sound (lay p) isW)
    (w_stk : Ram (p.sp - F) F)
    (w_aS : Hdr m p.pa p.adp p.a)
    (w_aD : Dig m p.adp p.a.alloc p.a.digit)
    (w_bS : Hdr m p.pb p.bdp p.b)
    (w_bD : Dig m p.bdp p.b.alloc p.b.digit)
    (w_cS : Hdr m p.pc p.cdp p.c)
    (w_cD : Dig m p.cdp p.c.alloc p.c.digit)
    (w_code : Img m)
    (heap : AHeap m p.H)
    (off : ∀ (r : R), Off (lay p r) p.H) :
    Triple
      (At 0x8000105c#64
        [(1, ra), (2, BitVec.ofNat 64 p.sp), (3, gpV), (10, BitVec.ofNat 64 p.pa), (11, BitVec.ofNat 64 p.pb),
          (12, BitVec.ofNat 64 p.pc)]
        m v.keep outp)
      fun cf =>
      ∃ x M,
        At ra
            [(1, ra),
              (10,
                match x with
                | Out.ok c' => 0#64
                | x => MpInit.memBV)]
            M v.keep outp cf ∧
          (match x with
            | Out.ok c' => GcdPost p.a p.b c' ∧ c'.alloc = p.c.alloc
            | Out.memU => True
            | Out.memV q => Fresh p.H q (4 * initPrec p.a.used)) ∧
            HPost (lay p) [R.stk, R.cS, R.cD] R.cD (out p x) (site' p x) p.H
              (match x with
              | Out.memV q => (q, 4 * initPrec p.a.used) :: p.H
              | x => p.H)
              m M :=
  have H : Tom.Machine.Api.MpGcd.Statement := Tom.Machine.Fn.MpGcdG5.correct
  @H p m v outp ra ra_al ⟨⟨stk_al, stk_lo, stk_hi⟩, va, vb, sc, abits, bbits, room, ablk, bblk,
      apos, bpos, aoff, boff, coff⟩ sound (fun r => match r with
        | .stk => ⟨trivial, w_stk⟩
        | .aS => ⟨Iv.sub_self _, w_aS⟩
        | .aD => ⟨Iv.sub_self _, w_aD⟩
        | .bS => ⟨Iv.sub_self _, w_bS⟩
        | .bD => ⟨Iv.sub_self _, w_bD⟩
        | .cS => ⟨Iv.sub_self _, w_cS⟩
        | .cD => ⟨Iv.sub_self _, w_cD⟩
        | .code => ⟨Iv.sub_self _, w_code⟩)
      heap off
