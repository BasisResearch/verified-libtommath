theorem _root_.Specs.mp_mul_2d_correct_inplace {p : P} {m : Mem} {v : Abi} {outp : Array String}
    {ra : BitVec 64}
    (ra_al : ra.toNat % 4 = 0)
    (stk_al : p.sp % 16 = 0)
    (stk_lo : heapEnd + F ≤ p.sp)
    (stk_hi : p.sp ≤ 0x100000000)
    (sa : p.a.Shape)
    (b_lt : p.b < 2 ^ 31)
    (size_lt : p.a.used + p.b / 28 + 1 < 2 ^ 31)
    (apos : 0 < p.a.alloc)
    (aoff : OffHeap p.pa 24)
    (sound : Sound (lay p) isW)
    (w_stk : Ram (p.sp - F) F)
    (w_aS : Hdr m p.pa p.adp p.a)
    (w_aD : Dig m p.adp p.a.alloc p.a.digit)
    (w_code : Img m)
    (heap : AHeap m (digBlk p.adp p.a :: p.H))
    (off : ∀ (r : R), Off (lay p r) (digBlk p.adp p.a :: p.H)) :
    Triple
      (At 0x80001758#64
        [(1, ra), (2, BitVec.ofNat 64 p.sp), (3, gpV), (10, BitVec.ofNat 64 p.pa), (11, BitVec.ofNat 64 p.b),
          (12, BitVec.ofNat 64 p.pa)]
        m v.keep outp)
      fun cf =>
      ∃ x M,
        At ra
            [(1, ra),
              (10,
                match x with
                | none => MpGrow.memBV
                | some val => 0#64)]
            M v.keep outp cf ∧
          (match x with
            | none => p.a.alloc < p.a.used + p.b / 28 + 1
            | some (fst, a') => Mul2dPost p.a p.b (mul2dIn p.a p.b) a') ∧
            HPost (lay p) [R.stk, R.aS, R.aD] R.aD (out p x) (site' p x) (digBlk p.adp p.a :: p.H)
              (match x with
              | none => digBlk p.adp p.a :: p.H
              | some (q, a') => (q, 4 * a'.alloc) :: p.H)
              m M :=
  have H : Tom.Machine.Api.MpMul2dI.Statement := Tom.Machine.Fn.MpMul2dIG5.correct
  @H p m v outp ra ra_al ⟨⟨stk_al, stk_lo, stk_hi⟩, sa, b_lt, size_lt, apos, aoff⟩ sound
      (fun r => match r with
        | .stk => ⟨trivial, w_stk⟩
        | .aS => ⟨Iv.sub_self _, w_aS⟩
        | .aD => ⟨Iv.sub_self _, w_aD⟩
        | .code => ⟨Iv.sub_self _, w_code⟩)
      heap off
end Tom.Machine.Api.MpMul2dI

