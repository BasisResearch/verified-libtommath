namespace Tom.Machine.Api.MpToRadix
open LeanRV64DExecutable Vsa Vsa.Sim Vsa.Logic
open Tom.Machine Tom.Machine.Code Tom.Machine.Api.Alloc Tom.Machine.Api.Heap Tom.Machine.Std Tom.Radix
theorem _root_.Specs.mp_to_radix_correct {p : P} {m : Mem} {v : Abi} {outp : Array String}
    {ra : BitVec 64}
    (ra_al : ra.toNat % 4 = 0)
    (stk_al : p.sp % 16 = 0)
    (stk_lo : heapEnd + F ≤ p.sp)
    (stk_hi : p.sp ≤ 0x100000000)
    (va : p.a.Valid)
    (ablk : digBlk p.adp p.a ∈ p.H)
    (apos : 0 < p.a.alloc)
    (aoff : OffHeap p.pa 24)
    (rx_lt : p.radix < 2 ^ 31)
    (sound : Sound (lay p) isW)
    (w_stk : Ram (p.sp - F) F)
    (w_aS : Hdr m p.pa p.adp p.a)
    (w_aD : Dig m p.adp p.a.alloc p.a.digit)
    (w_str : Ram p.pstr p.maxlen ∧
        ∀ (x : Nat),
          (Iv.mk p.pstr p.maxlen).In x →
            getElem? (valid := fun m a => a ∈ m) m x = getElem? (valid := fun m a => a ∈ m) p.m0 x)
    (w_code : Img m)
    (heap : AHeap m p.H)
    (off : ∀ (r : R), Off (lay p r) p.H) :
    Triple
      (At 0x80001f80#64
        [(1, ra), (2, BitVec.ofNat 64 p.sp), (3, gpV), (10, BitVec.ofNat 64 p.pa), (11, BitVec.ofNat 64 p.pstr),
          (12, BitVec.ofNat 64 p.maxlen), (13, 0#64), (14, BitVec.ofNat 64 p.radix)]
        m v.keep outp)
      fun cf =>
      ∃ x M,
        At ra [(1, ra), (10, BitVec.ofInt 64 x.fst)] M v.keep outp cf ∧
          (ToRadixPost p.a p.maxlen (↑p.radix) false (bytesOf p.m0 p.pstr p.maxlen) (bytesOf x.snd p.pstr p.maxlen) 0 0
                x.fst ∨
              x.fst = Layout.mpMem) ∧
            HPost (lay p) [R.stk, R.str] R.str (out p x) (site' p x) p.H p.H m M :=
  have H : Tom.Machine.Api.MpToRadix.Statement := Tom.Machine.Fn.MpToRadixG5.correct
  @H p m v outp ra ra_al ⟨⟨stk_al, stk_lo, stk_hi⟩, va, ablk, apos, aoff, rx_lt⟩ sound
      (fun r => match r with
        | .stk => ⟨trivial, w_stk⟩
        | .aS => ⟨Iv.sub_self _, w_aS⟩
        | .aD => ⟨Iv.sub_self _, w_aD⟩
        | .str => ⟨trivial, w_str⟩
        | .code => ⟨Iv.sub_self _, w_code⟩)
      heap off
end Tom.Machine.Api.MpToRadix

namespace Tom
open Radix
theorem _root_.Specs.ToRadixPost_spec_ok {a : MpInt} {maxlen : Nat} {radix : Int} {hasW : Bool}
    {buf buf' : Nat → Nat} {w w' : Nat} {ret : Int}
    (ha : a.Valid)
    (hr : radixOk radix)
    (hfit : (toRadixStr a radix.toNat).length ≤ maxlen)
    (hm : 2 ≤ maxlen)
    (h : ToRadixPost a maxlen radix hasW buf buf' w w' ret) :
    ret = Layout.mpOkay ∧
      (∀ (i : Nat), buf' i = (toRadixStr a radix.toNat).getD i (buf i)) ∧
        w' = if hasW = true then (toRadixStr a radix.toNat).length else w :=
  @Tom.ToRadixPost.spec_ok a maxlen radix hasW buf buf' w w' ret ha hr hfit hm h
end Tom

namespace Tom
open Radix
theorem _root_.Specs.ToRadixPost_spec_err {a : MpInt} {maxlen : Nat} {radix : Int} {hasW : Bool}
    {buf buf' : Nat → Nat} {w w' : Nat} {ret : Int}
    (ha : a.Valid)
    (h : ToRadixPost a maxlen radix hasW buf buf' w w' ret) :
    (maxlen < 2 → ret = mpBuf ∧ buf' = buf ∧ w' = w) ∧
      (2 ≤ maxlen → ¬radixOk radix → ret = Layout.mpVal ∧ buf' = buf ∧ w' = w) ∧
        (2 ≤ maxlen → radixOk radix → maxlen < (toRadixStr a radix.toNat).length → ret = mpBuf ∧ w' = w) :=
  @Tom.ToRadixPost.spec_err a maxlen radix hasW buf buf' w w' ret ha h
end Tom


