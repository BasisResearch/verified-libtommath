theorem edges (z : Fx) (hc : Cx z) : ∀ l x, Lbl.Edge (LL z) (Post z) l x
  | .E, x => eE z hc x
  | .L2, x => eL2 z hc x
  | .D2, x => eD2 z hc x
  | .K2, x => eK2 z hc x
  | .KD, x => eKD z hc x
  | .N, x => eN z hc x
  | .R, x => eR z hc x

/-- **`mp_exptmod` on the machine.** -/
theorem correct : Api.MpExptmodOf.Statement := by
  intro p m v outp ra hra hres hS hB hH hoff c hc; obtain ⟨vsp, gp, tp, s0, s⟩ := v; have hsp := At.sp_eq hc (x := BitVec.ofNat 64 p.sp) rfl; have hgp := At.gp_eq hc (x := gpV) rfl; simp only at hsp hgp; subst hsp hgp; revert c hc; have hP : GPre p m ra := ⟨hra, hres, hS, hB, hH, hoff, soundG hS hB⟩
  have hc : Cx ⟨p, m, tp, s0, s, outp, ra⟩ := ⟨hP⟩
  exact Lbl.start (L := LL _ .E) (x := ⟨()⟩) (run (LL _) _ (edges _ hc) .E ⟨()⟩)
    ⟨entry_state hc⟩ (fun cf hat => hat.sub rfl rfl)

