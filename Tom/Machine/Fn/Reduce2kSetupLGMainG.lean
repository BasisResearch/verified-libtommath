            wsite := ⟨Iv.sub_self _, h48.dig (nR .dD) rfl⟩
            place := Place.trans (I0 := ⟨z.p.ddp, 4 * z.p.d.alloc⟩) .keep (fun e he => List.mem_cons_of_mem _ he) hpl
            frame := hfr, heap := hh
            foot := fun y hy => (foot_uncons (e := digBlk z.p.ddp z.p.d) (Foot.of_cons hy)).imp id id
            off := hp51.off (nR .dD) }⟩

theorem edges (z : Fx) (hc : Cx z) : ∀ l x, Lbl.Edge (LL z) (Post z) l x
  | .E, x => eE z hc x

