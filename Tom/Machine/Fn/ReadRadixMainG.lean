theorem edges (z : Fx) (hc : Cx z) : ∀ l x, Lbl.Edge (LL z) (Post z) l x
  | .E, x => eE z hc x
  | .H, x => eH z hc x
  | .U, x => eU z hc x
  | .B, x => eB z hc x
  | .F, x => eF z hc x

/-- **`mp_read_radix` on the machine.** -/
theorem correct : Api.ReadRadix.Statement := by
  intro m v outp sp pa adp pstr radix a s ra s0 hP
  have hc : Cx ⟨⟨sp, pa, adp, pstr, radix, a, s⟩, m, v, outp, ra, s0⟩ := ⟨hP⟩
  exact Lbl.start (L := LL _ .E) (x := ⟨()⟩) (run (LL _) _ (edges _ hc) .E ⟨()⟩)
    ⟨entry_state hc⟩ (fun cf hat => hat.sub rfl rfl)

