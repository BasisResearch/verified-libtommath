  f0 : bytesT4 M a = BitVec.ofNat 32 x
  f1 : x < 268435456
  f2 : Ram a 4

structure LW (M : Mem) (w a : Nat) : Prop where
  f0 : bytesT8 M a = BitVec.ofNat 64 w
  f1 : w < 2 ^ 64
  f2 : Ram a 8

structure WS (a : Nat) : Prop where
  f0 : Ram a 8
  f1 : a % 8 = 0
  f2 : a + 8 ≤ sMpMontgomeryReduceFastBase ∨ sMpMontgomeryReduceFastBase + 864 ≤ a

structure XA (sp pn al xdp : Nat) : Prop where
  f0 : Ram xdp (4 * al)
  f1 : xdp % 4 = 0
  f2 : xdp + 4 * al ≤ sMpMontgomeryReduceFastBase ∨ sMpMontgomeryReduceFastBase + 864 ≤ xdp
  f3 : xdp + 4 * al ≤ sp - 4256 ∨ sp ≤ xdp
  f4 : xdp + 4 * al ≤ pn ∨ pn + 24 ≤ xdp
  f5 : al < 2 ^ 31

structure L0 (M : Mem) (sp px rho ou : Nat) : Prop where
  f0 : bytesT8 M (sp - 4240) = BitVec.ofNat 64 ou
  f1 : bytesT8 M (sp - 4248) = BitVec.ofNat 64 rho
  f2 : bytesT8 M (sp - 4232) = BitVec.ofNat 64 px

structure L1 (M : Mem) (sp px rho nu ou : Nat) : Prop where
  f0 : bytesT8 M (sp - 4240) = BitVec.ofNat 64 ou
  f1 : bytesT8 M (sp - 4248) = BitVec.ofNat 64 rho
  f2 : bytesT8 M (sp - 4232) = BitVec.ofNat 64 px
  f3 : bytesT8 M (sp - 4216) = BitVec.ofNat 64 (2 * nu)
  f4 : bytesT8 M (sp - 4224) = BitVec.ofNat 64 (8 * nu)

end Tom.Machine.Fn.MontRedFastG
