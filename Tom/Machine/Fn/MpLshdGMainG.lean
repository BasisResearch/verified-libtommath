    (PL.mk' z M1 xc.Mk xc.m0 xc.q xc.A 0 (h9.congrK (by krfl)) hp rf pl hA hk0 hu0 (by om)) fun _ h => h

theorem eL (z : Fx) (hc : Cx z) (xc : XL) : Lbl.Edge (LL z) (Post z) .L xc := by
  refine Lbl.enter fun ⟨st, hp, rf, pl, hA, hk0, hu0, ht⟩ => ?_
  show Triple (At _ _ _ _ _) _
  have hres := hc.res; have hS := hc.sound; have hB := hc.bund; have hoff := hc.off; have hra := hc.ra4
  have hst := hres.stk; have := hst.lo; have := hst.al; have := hst.hi
  have hsa := hres.sa; have := hsa.used_le; have := hsa.alloc_lt; have := hres.k_lt; have hsz := hres.size_lt; have := hres.apos
  have eE : heapEnd = 0x87800000 := rfl; have eF : Api.MpLshdG.F = 576 := rfl; have eB : mpLshdBase = 0x800015b8 := rfl; have eG : MpGrow.F = 544 := rfl
  have eTB : textBase = 0x80000000 := rfl; have eTL : textLen = 0x18880 := rfl; have eS : heapStart = 0x80019d10 := rfl
  have hR : RamH (z.p.sp - 32) 32 := ⟨Ram.sub (hB .stk).2 (by simp only [lay, eF]; omega) (by simp only [lay, eF]; omega)⟩
  have hpa := hS .aS .stk (by decide); have hco := hS .stk .code (by decide); have hca := hS .aS .code (by decide)
  simp only [Iv.Disj, Disj, lay, eF, textIv] at hpa hco hca
  have hg := lshdIn_grown hsa hsz; rw [← hA] at hg; have hgs := hg.shape; have := hgs.used_le; have := hgs.alloc_lt
  have hroom : xc.A.used + z.p.k ≤ xc.A.alloc := by have := lshdIn_room z.p.a hk0 hu0; rw [← hA] at this; exact this
  have hgu := hg.used
  have hdl : ∀ j, lshdT xc.A z.p.k xc.t j < 268435456 := lshdT_lt hgs z.p.k xc.t
  by_cases hb : xc.t + 1 < xc.A.used
  · refine st.seqD (nR .aD) rfl (lp_step  z.v z.o z.p.sp xc.A.used z.p.k xc.q xc.t (lshdT xc.A z.p.k xc.t (xc.A.used - 1 - xc.t)) xc.M (cd st) (by cfacts st) (by cfacts st) (by cfacts st) (by side st) (by side st) (by side st) (by side st)) (by omega) (Nat.lt_of_lt_of_le (hdl _) (by decide)) fun M1 h2 => ?_
    have h3 := h2.reD (nR .aD) rfl rfl (lshdT_succ xc.A hk0 ht)
    exact Lbl.jump (L := LL z) .L ⟨M1, xc.Mk, xc.m0, xc.q, xc.A, xc.t + 1⟩ (by dec)
      (PL.mk' z M1 xc.Mk xc.m0 xc.q xc.A (xc.t + 1) (h3.congrK (by krfl)) hp rf pl hA hk0 hu0 (by om)) fun _ h => h
  · refine st.seqD (nR .aD) rfl (lx_step  z.v z.o z.p.sp xc.A.used z.p.k xc.q xc.t (lshdT xc.A z.p.k xc.t (xc.A.used - 1 - xc.t)) xc.M (cd st) (by cfacts st) (by cfacts st) (by cfacts st) (by side st) (by side st) (by side st) (by side st)) (by omega) (Nat.lt_of_lt_of_le (hdl _) (by decide)) fun M4 h5 => ?_
    have h6 := h5.reD (nR .aD) rfl rfl (lshdT_last xc.A hk0 (by omega))
    refine call_std Std.memsetD ⟨xc.q,  xc.A.alloc,  lshdT xc.A z.p.k xc.A.used,  0,  z.p.k,  z.p.k⟩ (fun r : Dz => match r with | .D => (nR .aD : X) | .code => (nR .code : X)) h6 (cd h6) 0x565070ef#32 0x7d64#21 0x80001644#64 (⟨by om, by om, by om⟩) fun _ M7 hq9 h8 => ?_
    try dsimp only at hq9
    refine St.seq0 (r_step z.ra z.v z.o z.p.sp M7 (cd h8) (by cfacts h8) (by cfacts h8) hra) ?_
    have h12 := h8.setMp (nR .aS) (nR .aD) rfl rfl (lshdRes xc.A z.p.k) rfl rfl rfl rfl (by intro j hj; rw [lshdRes, MpInt.ofDigits_digit, if_pos hj]; exact (lshdT_fill xc.A z.p.k j).symm)
    obtain ⟨hfr, hh⟩ := hp.fin h12
    have hQ : LshdPost (lshdIn z.p.a z.p.k) z.p.k (lshdRes xc.A z.p.k) := by
      rw [← hA]; exact ⟨fun h => absurd h (by omega), fun _ _ => lshdRes_shift hgs hroom⟩
    exact Lbl.exit fun cf hat => ⟨some (xc.q, lshdRes xc.A z.p.k), M7, hat.sub rfl rfl, hQ,
      { wit := fun r hr hrs => by
          cases r with
