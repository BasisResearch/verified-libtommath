  have hP := hc.pre; have := hP.sp_ge; have := hP.sp_al; have hra := hP.ra_al; have hb := hP.b_lt
  have hroom : z.p.a.used + z.p.b / 28 + 1 ≤ z.p.c.alloc := hP.room; have := hP.va.used_le; have := hP.va.alloc_lt
  have := hP.sc.used_le; have := hP.sc.alloc_lt; have := hP.ga.st.hi_le; have := hP.gc.st.hi_le
  have hne : z.p.pa ≠ z.p.pc := by have := hP.lay .aS .bS (by decide); dsimp only [Iv.Disj, Disj, Api.MpMul2d.lay, Two.lay] at this; omega
  have hR : RamH (z.p.sp - 48) 48 := ⟨Ram.sub hP.rs (by omega) (by omega)⟩; have eB : mpMul2dBase = 0x80001758 := rfl
  have eTB : textBase = 0x80000000 := rfl; have eTL : textLen = 0x18880 := rfl
  have hco := hP.lay .stk .code (by decide); dsimp only [Iv.Disj, Disj, Api.MpMul2d.lay, Two.lay, textIv] at hco
