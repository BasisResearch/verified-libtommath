theorem correct : Api.MpMulG.Statement := by
  intro p m v outp ra hra hres hS hB hH hoff c hc; obtain ⟨vsp, gp, tp, s0, s⟩ := v; have hsp := At.sp_eq hc (x := BitVec.ofNat 64 p.sp) rfl; have hgp := At.gp_eq hc (x := gpV) rfl; simp only at hsp hgp; subst hsp hgp; revert c hc; have hP : MPre p m ra := ⟨hra, hres, hS, hB, hH, hoff⟩
  have hc : Cx ⟨p, m, tp, s0, s, outp, ra⟩ := ⟨hP⟩
  exact Lbl.start (L := LL _ .E) (x := ⟨()⟩) (run (LL _) _ (edges _ hc) .E ⟨()⟩)
    ⟨entry_state hc⟩ (fun cf hat => hat.sub rfl rfl)

