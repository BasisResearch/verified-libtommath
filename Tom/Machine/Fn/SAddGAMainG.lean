theorem eK (z : Fx) (hc : Cx z) (xc : XK) : Lbl.Edge (LL z) (Post z) .K xc := by
  refine Lbl.enter fun ⟨st, hp, rx, pl, hA, hmx⟩ => ?_
  show Triple (At _ _ _ _ _) _
  have hres := hc.res; have hS := hc.sound; have hB := hc.bund; have hoff := hc.off; have hra := hc.ra4
  have hst := hres.stk; have := hst.lo; have := hst.al; have := hst.hi
  have hsa := hres.sa; have := hsa.used_le; have := hsa.alloc_lt; have hsb := hres.sb; have := hsb.used_le; have := hsb.alloc_lt
  have hsz := hres.size_lt; have := hres.apos; have := hres.bpos
  have eE : heapEnd = 0x87800000 := rfl; have eF : Api.SAddGA.F = 608 := rfl; have eB : sMpAddBase = 0x8000219c := rfl; have eG : MpGrow.F = 544 := rfl
  have eTB : textBase = 0x80000000 := rfl; have eTL : textLen = 0x18880 := rfl; have eS : heapStart = 0x80019d10 := rfl
  have hR : RamH (z.p.sp - 64) 64 := ⟨Ram.sub (hB .stk).2 (by simp only [lay, eF]; omega) (by simp only [lay, eF]; omega)⟩
  have hpa := hS .aS .stk (by decide); have hpb := hS .bS .stk (by decide); have hco := hS .stk .code (by decide)
  simp only [Iv.Disj, Disj, lay, eF, textIv] at hpa hpb hco
  have hg := sAddIn_grown hsa hsz; rw [← hA] at hg; have hsA := hg.shape; have := hsA.used_le; have := hsA.alloc_lt; have hgu := hg.used
  have hroom : max z.p.a.used z.p.b.used + 1 ≤ xc.A.alloc := by have := sAddIn_room z.p.a z.p.b z.p.a; rw [← hA] at this; exact this
  have hresA : (SAddG.res z.p.a z.p.b xc.A xc.mx).alloc = xc.A.alloc := rfl
  refine call_std Std.clamp ⟨z.p.pa,  xc.q,  SAddG.res z.p.a z.p.b xc.A xc.mx⟩ (fun r : Ob => match r with | .S => (nR .aS : X) | .D => (nR .aD : X) | .code => (nR .code : X)) st (cd st) 0x4f1020ef#32 0x2cf0#21 0x800022ec#64 (SAddG.res_shape hsa hsb hsA hmx (by omega)) fun c4 M1 hcl4 h2 => ?_
  try dsimp only at hcl4
  have h4 := h2.reD (nR .aD) rfl hcl4.alloc hcl4.digit
  refine St.seq0 (r_step z.ra z.s0 z.v z.o z.p.sp z.p.pa M1 (cd h4) (by cfacts h4) (by cfacts h4) hra) ?_
  obtain ⟨hfr, hh⟩ := hp.fin h4
  have hal4 : c4.alloc = xc.A.alloc := hcl4.alloc
  have hQ : SAddPost z.p.a z.p.b (sAddIn z.p.a z.p.b z.p.a) c4 := by rw [← hA]; exact SAddG.post hsa hsb hmx (by omega) hcl4
  exact Lbl.exit fun cf hat => ⟨some (xc.q, c4), M1, hat.sub rfl rfl, hQ,
    { wit := fun r hr hrs => by
        cases r with
        | stk => exact ⟨trivial, (hB .stk).2⟩
        | aS => exact ⟨Iv.sub_self _, h4.hdr (nR .aS) rfl⟩
        | aD => exact absurd rfl hrs
        | _ => simp [ws] at hr
      wsite := ⟨Iv.sub_self _, h4.dig (nR .aD) rfl⟩
      place := by show Place _ _ ⟨xc.q, 4 * c4.alloc⟩; rw [hal4]; exact pl
      frame := hfr, heap := by show AHeap _ ((xc.q, 4 * c4.alloc) :: z.p.H); rw [hal4]; exact hh
      foot := fun _ hx => (foot_uncons (e := digBlk z.p.adp z.p.a) (Foot.of_cons hx)).imp id id
      off := by show Off ⟨xc.q, 4 * c4.alloc⟩ ((xc.q, 4 * c4.alloc) :: z.p.H); rw [hal4]; exact hp.off (nR .aD) }⟩

theorem edges (z : Fx) (hc : Cx z) : ∀ l x, Lbl.Edge (LL z) (Post z) l x
  | .E, x => eE z hc x
  | .G1, x => eG1 z hc x
  | .L11, x => eL11 z hc x
  | .M1, x => eM1 z hc x
  | .L21, x => eL21 z hc x
  | .G2, x => eG2 z hc x
  | .L12, x => eL12 z hc x
  | .M2, x => eM2 z hc x
  | .L22, x => eL22 z hc x
  | .T, x => eT z hc x
  | .K, x => eK z hc x

