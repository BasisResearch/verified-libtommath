      (PT.mk' z M1 xc.a1 (Fn.MpDiv2d.fin z.p.a xc.c2 z.p.b) (h3.congrK (by krfl)) hmod (hm.fin_loop hsa hroom)) fun _ h => h
  · refine st.seqD (nR .bD) rfl (lp_step  z.v z.o z.p.sp z.p.pa z.p.pc z.p.b (z.p.b % 28) z.p.cdp xc.x xc.r (xc.f xc.x) xc.M (cd st) (by cfacts st) (by cfacts st) (by side st) (by side st) (by side st) (by side st)) (by omega) (by omega) fun M4 h5 => ?_
    exact Lbl.jump (L := LL z) .L ⟨M4, xc.a1, xc.c2, xc.x - 1, (xc.f xc.x)%2^(z.p.b % 28), Mont.upd xc.f xc.x ((xc.f xc.x) / 2 ^ (z.p.b % 28) + xc.r * 2 ^ (28 - (z.p.b % 28)))⟩ (by dec)
      (PL.mk' z M4 xc.a1 xc.c2 (xc.x - 1) ((xc.f xc.x)%2^(z.p.b % 28)) (Mont.upd xc.f xc.x ((xc.f xc.x) / 2 ^ (z.p.b % 28) + xc.r * 2 ^ (28 - (z.p.b % 28)))) (h5.congrK (by krfl)) hm hmod hd0 (by side h5) (Div2dRStep.DL.step pr hsa hm.dig (by om) hi)) fun _ h => h

theorem eT (z : Fx) (hc : Cx z) (xc : XT) : Lbl.Edge (LL z) (Post z) .T xc := by
  refine Lbl.enter fun ⟨st, hmod, hf3⟩ => ?_
  show Triple (At _ _ _ _ _) _
  have hP := hc.pre; have hsa := hP.va.toShape; have := hP.va.used_le; have := hP.va.alloc_lt; have := hP.sc.used_le
  have := hP.sc.alloc_lt; have := hP.sp_ge; have := hP.sp_al; have hra := hP.ra_al; have hb := hP.b_lt; have hb0 := hP.b_pos
  have hroom := hP.room; have hbits : 28 * z.p.a.used < 2 ^ 31 := hP.bits; have := hP.ga.st.lo_ge; have := hP.ga.st.hi_le
  have := hP.gc.ds.lo_ge; have hcd : z.p.cdp + 4 * z.p.c.alloc ≤ 2 ^ 32 := hP.gc.ds.hi_le
  have hR : RamH (z.p.sp - 64) 64 := ⟨Ram.sub hP.rs (by omega) (by omega)⟩; have eB : mpDiv2dBase = 0x8000520c := rfl
  have eTB : textBase = 0x80000000 := rfl; have eTL : textLen = 0x18880 := rfl
  have hco := hP.lay .stk .code (by decide); dsimp only [Iv.Disj, Disj, Api.MpDiv2dR.lay, Two.lay, textIv] at hco
  have := hf3.alloc
  refine call_std Std.clamp ⟨z.p.pc,  z.p.cdp,  xc.c3⟩ (fun r : Ob => match r with | .S => (nR .bS : X) | .D => (nR .bD : X) | .code => (nR .code : X)) st (cd st) 0xcf9ff0ef#32 0x1ffcf8#21 0x800052e4#64 (hf3.shape hsa hP.sc hroom) fun c4 M1 hcl h2 => ?_
  try dsimp only at hcl
  have h4 := h2.reD (nR .bD) rfl hcl.alloc hcl.digit
  refine St.seq0 (e_step z.ra z.s0 z.v.s.s1 z.v.s.s2 z.v.s.s3 z.v z.o z.p.sp M1 (cd h4) (by cfacts h4) (by cfacts h4) hra) ?_
  exact Lbl.exit fun cf hat => ⟨xc.a1, c4, M1, hat.sub rfl rfl,
    { reprA := h4.mpAt (nR .aS) (nR .aD) rfl rfl, reprC := h4.mpAt (nR .bS) (nR .bD) rfl rfl, div := hf3.post hcl, mod := hmod,
      frame := h4.unsplit (by exact (by decide : 64 ≤ 112)) }⟩

theorem edges (z : Fx) (hc : Cx z) : ∀ l x, Lbl.Edge (LL z) (Post z) l x
  | .E, x => eE z hc x
  | .M, x => eM z hc x
  | .L, x => eL z hc x
  | .T, x => eT z hc x

/-- **`mp_div_2d(a, b, c, a)` on the machine.** -/
theorem correct : Api.MpDiv2dR.Statement := by
  intro m v outp sp pa adp pc cdp a b c ra s0 hP
  have hc : Cx ⟨⟨sp, pa, adp, pc, cdp, a, b, c⟩, m, v, outp, ra, s0⟩ := ⟨hP⟩
  exact Lbl.start (L := LL _ .E) (x := ⟨()⟩) (run (LL _) _ (edges _ hc) .E ⟨()⟩)
    ⟨entry_state hc⟩ (fun cf hat => hat.sub rfl rfl)

