            | aS => exact ⟨Iv.sub_self _, h18.hdr (nR .aS) rfl⟩
            | aD => exact absurd rfl hrs
            | _ => simp [ws] at hr
          wsite := ⟨Iv.sub_self _, h18.dig (nR .aD) rfl⟩, place := hpl
          frame := hfr, heap := by show AHeap _ ((xc.q, 4 * x3.alloc) :: z.p.H); rw [hal3]; exact hh, foot := fun y hy => (foot_uncons (e := digBlk z.p.adp z.p.a) (Foot.of_cons hy)).imp id id
          off := by show Off ⟨xc.q, 4 * x3.alloc⟩ ((xc.q, 4 * x3.alloc) :: z.p.H); rw [hal3]; exact hp.off (nR .aD) }⟩
    · simp only [Std.cmpMag, cmp_ge hlt]; have hc1 : (if x3.mag = z.p.n.mag then 0 else 1) ≤ 1 := by split <;> omega
      refine St.seq0 (ge_step z.ra z.s0 z.s.s1 z.s.s2 z.s.s3 z.s.s4 z.s.s5 z.s.s6 z.s.s7 z.s.s8 z.s.s9 z.s.s10 z.s.s11 z.v z.o z.p.sp z.p.pa z.p.pn z.p.d (if x3.mag = z.p.n.mag then 0 else 1) M17 (cd h18) (by cfacts h18) (by cfacts h18) (by side h18) (by side h18)) ?_
      have h24 := h18.forget nF rfl
      refine tail_seq Std.sSubA ⟨z.p.sp,  z.p.pa,  xc.q,  z.p.pn,  z.p.ndp,  x3,  z.p.n⟩ (fun r : BinA.R => match r with | .stk => (nF : X) | .aS => (nR .aS : X) | .aD => (nR .aD : X) | .bS => (nR .nS : X) | .bD => (nR .nD : X) | .code => (nR .code : X)) h24 (⟨hmid.valid.toShape, hvn.toShape, hmid.valid.sign_ok, hmid.ge hvn hlt, by om, by om⟩) hra (K' := z.v.keep) fun x4 M25 hss h26 => ?_
      try dsimp only at hss
