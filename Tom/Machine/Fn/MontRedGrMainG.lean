      exact Lbl.exit fun cf hat => ⟨(true, xc.q, x4), M25, hat.sub rfl rfl, ⟨(hmid.fin_sub hvn hnp hlt hss).valid.toShape, by rw [hal4]; omega, hpl, fun _ => RedcPost.toV hAm hAs (hmid.fin_sub hvn hnp hlt hss)⟩,
        { wit := fun r hr hrs => by
            cases r with
            | stk => exact ⟨trivial, (hB .stk).2⟩
            | aS => exact ⟨Iv.sub_self _, h26.hdr (nR .aS) rfl⟩
            | aD => exact absurd rfl hrs
            | _ => simp [ws] at hr
          wsite := ⟨Iv.sub_self _, h26.dig (nR .aD) rfl⟩, place := hpl
          frame := hfr, heap := by show AHeap _ ((xc.q, 4 * x4.alloc) :: z.p.H); rw [hal4]; exact hh, foot := fun y hy => (foot_uncons (e := digBlk z.p.adp z.p.a) (Foot.of_cons hy)).imp id id
          off := by show Off ⟨xc.q, 4 * x4.alloc⟩ ((xc.q, 4 * x4.alloc) :: z.p.H); rw [hal4]; exact hp.off (nR .aD) }⟩

theorem edges (z : Fx) (hc : Cx z) : ∀ l x, Lbl.Edge (LL z) (Post z) l x
  | .E, x => eE z hc x
  | .O, x => eO z hc x
  | .I, x => eI z hc x
  | .C, x => eC z hc x
  | .N, x => eN z hc x

/-- **`mp_montgomery_reduce (growing)` on the machine.** -/
theorem correct : Api.MontRedGr.Statement := by
  intro p m v outp ra hra hres hS hB hH hoff c hc
  obtain ⟨vsp, gp, tp, s0, s⟩ := v
  have hsp := At.sp_eq hc (x := BitVec.ofNat 64 p.sp) rfl
  have hgp := At.gp_eq hc (x := gpV) rfl
  simp only at hsp hgp; subst hsp hgp
  revert c hc
  have hst := entry_state hres hS hB hH hoff
  exact Lbl.start (L := LL ⟨p, m, tp, s0, s, outp, ra⟩ .E) (x := ⟨()⟩)
    (run (LL ⟨p, m, tp, s0, s, outp, ra⟩) _ (edges _ ⟨hres, hS, hB, hH, hoff, hra⟩) .E ⟨()⟩)
    ⟨hst.1, hst.2⟩ (fun cf hat => hat.sub rfl rfl)

end Tom.Machine.Fn.MontRedGrG5
