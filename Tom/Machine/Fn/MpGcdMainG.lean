  | .C, x => eC z hc x
  | .K, x => eK z hc x
  | .D, x => eD z hc x
  | .L0, x => eL0 z hc x
  | .L1, x => eL1 z hc x

/-- **`mp_gcd` on the machine.** -/
theorem correct : Api.MpGcd.Statement := by
  intro p m v outp ra hra hres hS hB hH hoff c hc
  obtain ⟨vsp, gp, tp, s0, s⟩ := v
  have hsp := At.sp_eq hc (x := BitVec.ofNat 64 p.sp) rfl
  have hgp := At.gp_eq hc (x := gpV) rfl
  simp only at hsp hgp; subst hsp hgp
  revert c hc
  have hst := entry_state hres hS hB hH hoff
  exact Lbl.start (L := LL ⟨p, m, tp, s0, s, outp, ra⟩ .E) (x := ⟨()⟩)
    (run (LL ⟨p, m, tp, s0, s, outp, ra⟩) _ (edges _ ⟨hres, hS, hB, hH, hoff, hra⟩) .E ⟨()⟩)
    ⟨hst.1, hst.2⟩ (fun cf hat => hat.sub rfl rfl)

