  hp : HP (ρ2 z.p x.qu x.na x.qv x.nb) wX (Api.MpGcd.hin z.p) ((x.qv, 4 * x.nb) :: (x.qu, 4 * x.na) :: (Api.MpGcd.hin z.p)) (InAny (Api.MpGcd.lay z.p) Api.MpGcd.ws) z.m x.Mk
  hk : x.k = min (Gcd.lsb z.p.a.mag) (Gcd.lsb z.p.b.mag)
  tu : Tmp x.U x.nb x.U.mag (max z.p.a.used z.p.b.used)
  tv : Tmp x.V x.na x.V.mag (max z.p.a.used z.p.b.used)
