  hu0 : z.p.a.used ≠ 0
  hv0 : z.p.b.used ≠ 0
  hna : 0 < x.na
  hnb : 0 < x.nb

theorem PL1.mk' (z : Fx) (M : Mem) (Mk : Mem) (qu : Nat) (qv : Nat) (na : Nat) (nb : Nat) (k : Nat) (U : MpInt) (V : MpInt)
