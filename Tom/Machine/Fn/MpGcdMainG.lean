  | .L1 => ⟨XL1, fun x => (1, x.U.mag + x.V.mag, 0), PL1 z, fun x => At 0x800011c8#64 (lh z.p.sp z.p.pc x.k) x.M (kp z.v) z.o⟩

/-- The contract's post. -/
def Post (z : Fx) : Vsa.Machine.Config → Prop := fun cf => ∃ x M, At z.ra (Api.MpGcd.rets z.p x z.ra) M z.v.keep z.o cf ∧ Api.MpGcd.Q z.p x ∧ HPost (Api.MpGcd.lay z.p) Api.MpGcd.ws .cD (Api.MpGcd.out z.p x) (Api.MpGcd.site' z.p x) (Api.MpGcd.hin z.p) (Api.MpGcd.hout z.p x) z.m M

